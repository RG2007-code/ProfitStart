<Page x:Class="ProfitStart.PageAdmin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Админ-панель"
                           FontSize="26" FontWeight="Bold"
                           Margin="0,0,0,24"
                           Foreground="{DynamicResource TextPrimary}"/>

                <UniformGrid Columns="4" Margin="0,0,0,28">
                    <Border Background="{DynamicResource CardBg}"
                            CornerRadius="10"
                            Padding="20" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="Студенты"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="13"/>
                            <TextBlock x:Name="CntStudents"
                                       FontSize="26" FontWeight="Bold"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBg}"
                            CornerRadius="10"
                            Padding="20" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="Вакансии"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="13"/>
                            <TextBlock x:Name="CntVacancies"
                                       FontSize="26" FontWeight="Bold"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBg}"
                            CornerRadius="10"
                            Padding="20" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="Компании"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="13"/>
                            <TextBlock x:Name="CntCompanies"
                                       FontSize="26" FontWeight="Bold"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBg}"
                            CornerRadius="10"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Отклики"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="13"/>
                            <TextBlock x:Name="CntApps"
                                       FontSize="26" FontWeight="Bold"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="Администрирование"
                           FontSize="18" FontWeight="Bold"
                           Margin="0,0,0,14"
                           Foreground="{DynamicResource TextPrimary}"/>

                <UniformGrid Columns="3" Margin="0,0,0,28">
                    <Button Content="Управление навыками"
                            Height="60" Margin="0,0,14,0"
                            Style="{StaticResource PrimaryBtn}"
                            Click="ManageSkills_Click"/>
                    <Button Content="Управление компаниями"
                            Height="60" Margin="0,0,14,0"
                            Style="{StaticResource PrimaryBtn}"
                            Click="ManageCompanies_Click"/>
                    <Button Content="Модерация вакансий"
                            Height="60"
                            Style="{StaticResource PrimaryBtn}"
                            Click="ModerateVacancies_Click"/>
                </UniformGrid>

                <Grid Margin="0,0,0,14">
                    <TextBlock Text="Аналитика"
                               FontSize="18" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <TextBlock Text="Период:"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <ComboBox x:Name="PeriodFilter"
                                  Width="180" Height="36"
                                  Style="{StaticResource FlatCombo}"
                                  SelectedIndex="0"
                                  SelectionChanged="Period_Changed">
                            <ComboBoxItem Content="За 6 месяцев"/>
                            <ComboBoxItem Content="За 12 месяцев"/>
                            <ComboBoxItem Content="За всё время"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource CardBg}"
                            CornerRadius="10"
                            Padding="16" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Регистрации"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <Canvas x:Name="ChartRegistrations"
                                    Height="200"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{DynamicResource CardBg}"
                            CornerRadius="10"
                            Padding="16" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Вакансии по типам"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <Canvas x:Name="ChartVacancyTypes"
                                    Height="160"/>
                            <ItemsControl x:Name="VacancyLegend"
                                          Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,0,0,4">
                                            <Border Width="12" Height="12"
                                                    CornerRadius="3"
                                                    Background="{Binding Color}"
                                                    Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource CardBg}"
                            CornerRadius="10"
                            Padding="16" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Отклики по статусам"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <Canvas x:Name="ChartApplicationStatuses"
                                    Height="200"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{DynamicResource CardBg}"
                            CornerRadius="10"
                            Padding="16" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Топ-5 компаний по откликам"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <Canvas x:Name="ChartTopCompanies"
                                    Height="200"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="{DynamicResource CardBg}"
                        CornerRadius="10"
                        Padding="20" Margin="0,0,0,28">
                    <StackPanel>
                        <TextBlock Text="Сводка"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="SummaryText"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   LineHeight="22"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Экспорт данных"
                           FontSize="18" FontWeight="Bold"
                           Margin="0,0,0,14"
                           Foreground="{DynamicResource TextPrimary}"/>

                <Border Background="{DynamicResource CardBg}"
                        CornerRadius="10"
                        Padding="20" Margin="0,0,0,28">
                    <StackPanel>
                        <Button Content="Экспорт пользователей"
                                Height="48" Margin="0,0,0,10"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource GhostBtn}"
                                Click="ExportUsers_Click"/>
                        <Button Content="Экспорт вакансий"
                                Height="48" Margin="0,0,0,10"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource GhostBtn}"
                                Click="ExportVacancies_Click"/>
                        <Button Content="Экспорт практик"
                                Height="48" Margin="0,0,0,10"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource GhostBtn}"
                                Click="ExportPractices_Click"/>
                        <Button Content="Экспорт компаний"
                                Height="48" Margin="0,0,0,10"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource GhostBtn}"
                                Click="ExportCompanies_Click"/>
                        <Button Content="Экспорт откликов"
                                Height="48"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource GhostBtn}"
                                Click="ExportApplications_Click"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Последние заявки"
                           FontSize="16" FontWeight="Bold"
                           Margin="0,0,0,14"
                           Foreground="{DynamicResource TextPrimary}"/>

                <ItemsControl x:Name="LastApps">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBg}"
                                    CornerRadius="10"
                                    Padding="20,16" Margin="0,0,0,10">
                                <Grid>
                                    <TextBlock Text="{Binding Text}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding Status}"
                                               Foreground="{DynamicResource TextMuted}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>