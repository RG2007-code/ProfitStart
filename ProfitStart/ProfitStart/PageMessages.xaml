<Page x:Class="ProfitStart.PageMessages"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Сообщения"
                   FontSize="26" FontWeight="Bold"
                   Margin="0,0,0,20"
                   Foreground="{DynamicResource TextPrimary}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="DialogsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBg}"
                                CornerRadius="10"
                                Padding="20" Margin="0,0,0,10"
                                Cursor="Hand"
                                Tag="{Binding Id}"
                                MouseLeftButtonUp="Dialog_Click">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="48" Height="48" VerticalAlignment="Center">
                                        <Ellipse Width="48" Height="48"
                                                 Fill="{DynamicResource AccentBgSoft}"/>
                                        <Ellipse Width="48" Height="48"
                                                 Tag="{Binding AvatarData}"
                                                 Loaded="Avatar_Loaded"/>
                                    </Grid>
                                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="Bold" FontSize="15"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding LastMessage}"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontSize="12"
                                                   Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="600"
                                                   HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Background="#DC2626" CornerRadius="10"
                                        MinWidth="20" Height="20" Padding="6,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Visibility="{Binding UnreadVisibility}">
                                    <TextBlock Text="{Binding UnreadCount}"
                                               Foreground="White" FontSize="11"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="EmptyText"
                   Grid.Row="1"
                   Text="Пока нет сообщений"
                   Foreground="{DynamicResource TextPlaceholder}"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</Page>