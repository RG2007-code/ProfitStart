<Page x:Class="ProfitStart.PageEditCompany"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Редактирование компании"
                           FontSize="26" FontWeight="Bold"
                           Margin="0,0,0,24"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Text="Название"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,0,6"/>
                <Border Background="{DynamicResource CardBg}"
                        CornerRadius="10" Height="44">
                    <TextBox x:Name="NameBox" Background="Transparent"
                             BorderThickness="0" Padding="14,0,0,0"
                             VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource TextPrimary}"/>
                </Border>

                <TextBlock Text="ОГРН"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,16,0,6"/>
                <Border Background="{DynamicResource AccentBgSoft}"
                        CornerRadius="10" Height="44">
                    <TextBox x:Name="OgrnBox" Background="Transparent"
                             BorderThickness="0" Padding="14,0,0,0"
                             VerticalContentAlignment="Center"
                             IsReadOnly="True"
                             Foreground="{DynamicResource TextMuted}"/>
                </Border>

                <TextBlock Text="Сфера деятельности"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,16,0,6"/>
                <Border Background="{DynamicResource CardBg}"
                        CornerRadius="10" Height="44">
                    <TextBox x:Name="DirBox" Background="Transparent"
                             BorderThickness="0" Padding="14,0,0,0"
                             VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource TextPrimary}"/>
                </Border>

                <TextBlock Text="О компании"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,16,0,6"/>
                <Border Background="{DynamicResource CardBg}"
                        CornerRadius="10" MinHeight="120">
                    <TextBox x:Name="DescBox" Background="Transparent"
                             BorderThickness="0" Padding="14,10"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource TextPrimary}"/>
                </Border>

                <TextBlock Text="Аватар компании"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,16,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <Border Width="80" Height="80" CornerRadius="12"
                            Background="{DynamicResource AccentBgSoft}">
                        <Border x:Name="PreviewAvatar"
                                Width="80" Height="80" CornerRadius="12"/>
                    </Border>
                    <Button Content="Загрузить"
                            Height="40" Width="140"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource PrimaryBtn}"
                            Click="UploadAvatar_Click"/>
                </StackPanel>

                <TextBlock x:Name="StatusText" Foreground="#D97706"
                           FontSize="12" Margin="0,12,0,0"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="Отмена" Width="130" Height="44"
                            Margin="0,0,10,0"
                            Style="{StaticResource SecondaryBtn}"
                            Click="Cancel_Click"/>
                    <Button Content="Сохранить" Width="160" Height="44"
                            Style="{StaticResource PrimaryBtn}"
                            Click="Save_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>