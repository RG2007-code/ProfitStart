<Window x:Class="ProfitStart.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProfiStart — Вход"
        Height="680" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F6FA">
    <Grid>
        <Border Background="White" CornerRadius="16"
                Width="420" Padding="32,28"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>

                <Border Background="#5B5BF5" Width="52" Height="52"
                        CornerRadius="14" HorizontalAlignment="Center">
                    <TextBlock Text="P" Foreground="White"
                               FontWeight="Bold" FontSize="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Вход в ProfiStart"
                           FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,4"/>
                <TextBlock Text="Введите телефон и пароль"
                           Foreground="#6B7280"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                
                <TextBlock Text="Телефон" Foreground="#374151" Margin="0,0,0,6"/>
                <Border Background="#F5F6FA" CornerRadius="10" Height="44">
                    <TextBox x:Name="PhoneBox" Background="Transparent"
                             BorderThickness="0" Padding="14,0,0,0"
                             VerticalContentAlignment="Center"
                             PreviewTextInput="Phone_PreviewTextInput"
                             MaxLength="12"
                             Text="+7"/>
                </Border>

               
                <TextBlock Text="Пароль" Foreground="#374151"
                           Margin="0,14,0,6"/>
                <Border Background="#F5F6FA" CornerRadius="10" Height="44">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <PasswordBox x:Name="PasswordBox"
                                     Grid.Column="0"
                                     Background="Transparent"
                                     BorderThickness="0" Padding="14,0,0,0"
                                     VerticalContentAlignment="Center"/>

                        <TextBox x:Name="PasswordPlain"
                                 Grid.Column="0"
                                 Background="Transparent"
                                 BorderThickness="0" Padding="14,0,0,0"
                                 VerticalContentAlignment="Center"
                                 Visibility="Collapsed"/>

                        <Button x:Name="ToggleBtn"
                                Grid.Column="1"
                                Content="Показать"
                                MinWidth="80"
                                Margin="5,3,1,3"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                FontSize="12"
                                Foreground="#5B5BF5"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip="Показать пароль"
                                Click="TogglePassword_Click"/>
                    </Grid>
                </Border>

                <Button Content="Забыли пароль?"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Foreground="#5B5BF5"
                        FontSize="12"
                        HorizontalAlignment="Right"
                        Margin="0,6,0,0"
                        Click="ForgotPassword_Click"/>

                <TextBlock x:Name="ErrorText" Foreground="#DC2626"
                           FontSize="12" Margin="0,8,0,0"
                           TextWrapping="Wrap"/>

                
                <Button Content="Войти" Height="46" Margin="0,16,0,0"
                        Style="{StaticResource PrimaryBtn}"
                        Click="Login_Click"/>

                
                <TextBlock Text="Нет аккаунта?" Foreground="#6B7280"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>

                <Button Content="Зарегистрироваться" Height="44"
                        Margin="0,6,0,0"
                        Style="{StaticResource GhostBtn}"
                        Click="GoRegister_Click"/>

               
                <Button Content="На главную"
                        Height="36"
                        Margin="0,12,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Foreground="#5B5BF5"
                        FontSize="12"
                        Click="GoMainAsGuest_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>