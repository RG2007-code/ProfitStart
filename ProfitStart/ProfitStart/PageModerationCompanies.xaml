<Page x:Class="ProfitStart.PageModerationCompanies"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Модерация компаний"
                           FontSize="26" FontWeight="Bold"
                           Margin="0,0,0,24"
                           Foreground="{DynamicResource TextPrimary}"/>

                <ItemsControl x:Name="CompaniesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBg}"
                                    CornerRadius="10"
                                    Padding="20" Margin="0,0,0,12">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">

                                        <Grid Width="48" Height="48"
                                              VerticalAlignment="Center">
                                            <Ellipse Width="48" Height="48"
                                                     Fill="{DynamicResource AccentBgSoft}"/>
                                            <Ellipse Width="48" Height="48"
                                                     Tag="{Binding AvatarData}"
                                                     Loaded="CompanyAvatar_Loaded"/>
                                        </Grid>

                                        <StackPanel Margin="16,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="Bold" FontSize="15"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding Info}"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       FontSize="12"
                                                       Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="#D97706"
                                                       FontSize="12"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Content="Одобрить"
                                                Width="120" Height="38"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource PrimaryBtn}"
                                                Tag="{Binding Id}"
                                                Click="Approve_Click"/>
                                        <Button Content="Отклонить"
                                                Width="120" Height="38"
                                                Style="{StaticResource GhostBtn}"
                                                Tag="{Binding Id}"
                                                Click="Reject_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyText"
                           Text="Нет компаний на модерации"
                           Foreground="{DynamicResource TextPlaceholder}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,40,0,0"
                           Visibility="Collapsed"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>