<Window x:Class="ProfitStart.PasswordResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Восстановление пароля"
        Width="460"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PageBg}">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Background="{DynamicResource CardBg}"
                    CornerRadius="16"
                    Width="400" Padding="32"
                    Margin="10"
                    HorizontalAlignment="Center">
                <StackPanel>

                    <Border Background="#5B5BF5" Width="48" Height="48"
                            CornerRadius="12" HorizontalAlignment="Center">
                        <TextBlock Text="?" Foreground="White"
                                   FontWeight="Bold" FontSize="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Восстановление пароля"
                               FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,4"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Введите телефон, привязанный к аккаунту"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Телефон"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,6"/>
                    <Border Background="{DynamicResource AccentBgSoft}"
                            CornerRadius="10" Height="44">
                        <TextBox x:Name="PhoneBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="14,0,0,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="14"
                                 Foreground="{DynamicResource TextPrimary}"
                                 CaretBrush="{DynamicResource TextPrimary}"
                                 PreviewTextInput="Phone_PreviewTextInput"
                                 MaxLength="12"
                                 Text="+7"/>
                    </Border>

                    <TextBlock x:Name="MessageText"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>

                    <Button x:Name="ResetBtn"
                            Content="Сбросить пароль"
                            Height="44"
                            Margin="0,16,0,0"
                            Style="{StaticResource PrimaryBtn}"
                            Click="Reset_Click"/>

                    <StackPanel x:Name="ResultPanel"
                                Visibility="Collapsed"
                                Margin="0,16,0,0">

                        <Border Height="1"
                                Background="{DynamicResource BorderLine}"
                                Margin="0,0,0,16"/>

                        <TextBlock Text="Ваш временный пароль:"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>

                        <Border Background="{DynamicResource AccentBgSoft}"
                                CornerRadius="10"
                                Padding="16" Margin="0,8,0,0">
                            <TextBlock x:Name="TempPasswordText"
                                       FontFamily="Consolas"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#5B5BF5"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </Border>

                        <Button Content="Скопировать"
                                Height="40"
                                Margin="0,12,0,0"
                                Style="{StaticResource GhostBtn}"
                                Click="Copy_Click"/>

                        <TextBlock Text="Сохраните пароль — войдите с ним на странице входа и смените его в профиле."
                                   Foreground="{DynamicResource TextPlaceholder}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>

                    <Button Content="Закрыть"
                            Height="40"
                            Margin="0,16,0,0"
                            Style="{StaticResource GhostBtn}"
                            Click="Close_Click"/>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>