<Page x:Class="ProfitStart.PageModerationReviews"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Модерация отзывов"
                   FontSize="26" FontWeight="Bold"
                   Margin="0,0,0,20"
                   Foreground="{DynamicResource TextPrimary}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ReviewsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBg}"
                                CornerRadius="10"
                                Padding="20" Margin="0,0,0,12">
                            <Grid>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CompanyName}"
                                                   FontWeight="Bold" FontSize="15"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding Stars}"
                                                   Foreground="#F59E0B"
                                                   FontSize="14"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding AuthorName}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMuted}"
                                               Margin="0,4,0,0"/>

                                    <TextBlock Text="{Binding Comment}"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Button Content="Одобрить"
                                            Width="120" Height="38"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource PrimaryBtn}"
                                            Tag="{Binding Id}"
                                            Click="Approve_Click"/>
                                    <Button Content="Отклонить"
                                            Width="120" Height="38"
                                            Style="{StaticResource SecondaryBtn}"
                                            Tag="{Binding Id}"
                                            Click="Reject_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="EmptyText"
                   Grid.Row="1"
                   Text="Нет отзывов на модерации"
                   Foreground="{DynamicResource TextPlaceholder}"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</Page>