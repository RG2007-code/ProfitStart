<Page x:Class="ProfitStart.PageResume"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <StackPanel>

            <Button Content="← Назад"
                    HorizontalAlignment="Left"
                    Style="{StaticResource GhostBtn}"
                    Click="Back_Click"/>

            <TextBlock Text="Моё резюме"
                       FontSize="26" FontWeight="Bold"
                       Margin="0,16,0,24"
                       Foreground="{DynamicResource TextPrimary}"/>

            <Border Background="{DynamicResource CardBg}"
                    CornerRadius="12"
                    Padding="24">
                <StackPanel>

                    <TextBlock x:Name="NoResumeText"
                               Text="Резюме пока не загружено"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="14"
                               Margin="0,0,0,16"/>

                    <StackPanel x:Name="ResumeInfo"
                                Visibility="Collapsed"
                                Margin="0,0,0,16">
                        <TextBlock x:Name="FileNameText"
                                   FontWeight="Bold" FontSize="15"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="UploadedAtText"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="12"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="UploadBtn"
                                Content="Загрузить PDF"
                                Width="160" Height="40"
                                Style="{StaticResource PrimaryBtn}"
                                Click="Upload_Click"/>

                        <Button x:Name="OpenBtn"
                                Content="Открыть"
                                Width="120" Height="40"
                                Margin="10,0,0,0"
                                Style="{StaticResource GhostBtn}"
                                Visibility="Collapsed"
                                Click="Open_Click"/>

                        <Button x:Name="DeleteBtn"
                                Content="Удалить"
                                Width="120" Height="40"
                                Margin="10,0,0,0"
                                Style="{StaticResource GhostBtn}"
                                Visibility="Collapsed"
                                Click="Delete_Click"/>
                    </StackPanel>

                    <TextBlock Text="Допустимый формат: PDF, до 10 МБ"
                               Foreground="{DynamicResource TextPlaceholder}"
                               FontSize="11"
                               Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>