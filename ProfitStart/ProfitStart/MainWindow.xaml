<Window x:Class="ProfitStart.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProfitStart"
        mc:Ignorable="d"
        Title="ProfiStart" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBorder" Grid.Row="0" Background="White"
                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="20,0,0,0">
                    <Border Background="#5B5BF5" Width="32" Height="32" CornerRadius="8">
                        <TextBlock Text="P" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="AppTitleText" Text="ProfiStart"
                               FontSize="18" FontWeight="Bold"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Border x:Name="SearchBorder" Width="450" Height="38"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="330,0,0,0"
                        Background="#F5F6FA" CornerRadius="19">
                    <Grid>
                        <TextBox x:Name="GlobalSearchBox"
                                 Background="Transparent" BorderThickness="0"
                                 Padding="16,0,16,0"
                                 VerticalContentAlignment="Center"
                                 Foreground="#374151"
                                 TextChanged="GlobalSearch_TextChanged"/>
                        <TextBlock x:Name="GlobalSearchPlaceholder"
                                   Text="Поиск вакансий, профессий..."
                                   Foreground="#9CA3AF"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,20,0">

                    <Button x:Name="ThemeToggle"
                            Content="🌙"
                            Style="{StaticResource ThemeToggleBtn}"
                            ToolTip="Светлая / тёмная тема"
                            Margin="0,0,10,0"
                            Click="ThemeToggle_Click"/>

                    <Grid x:Name="MailIcon"
                          Cursor="Hand"
                          Margin="0,0,10,0"
                          MouseLeftButtonUp="Mail_Click">
                        <TextBlock Text="✉" FontSize="20" Margin="0"/>
                        <Border x:Name="MailBadge"
                                Background="#DC2626" CornerRadius="8"
                                MinWidth="16" Height="16" Padding="4,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-4,-6,0" Visibility="Collapsed">
                            <TextBlock x:Name="MailCount" Text="0"
                                       Foreground="White" FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Grid x:Name="BellIcon"
                          Cursor="Hand"
                          Margin="0,0,10,0"
                          MouseLeftButtonUp="Bell_Click">
                        <TextBlock Text="🔔" FontSize="18"/>
                        <Border x:Name="BellBadge"
                                Background="#DC2626" CornerRadius="8"
                                MinWidth="16" Height="16" Padding="4,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-4,-6,0" Visibility="Collapsed">
                            <TextBlock x:Name="BellCount" Text="0"
                                       Foreground="White" FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Grid x:Name="AvatarIcon"
                          Cursor="Hand"
                          MouseLeftButtonUp="Avatar_Click">
                        <Ellipse Width="32" Height="32"
                                 Stroke="#5B5BF5" StrokeThickness="2"/>
                        <Ellipse x:Name="AvatarImage" Width="28" Height="28"/>
                        <TextBlock x:Name="AvatarPlaceholderText"
                                   Text="?"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SidebarBorder" Background="White"
                    BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                <Grid>
                    <StackPanel Margin="10,20">
                        <Button x:Name="BtnMain"      Content="Главная"      Click="Nav_Click" Tag="main"      Style="{StaticResource MenuBtn}"/>
                        <Button x:Name="BtnVacancies" Content="Вакансии"     Click="Nav_Click" Tag="vacancies" Style="{StaticResource MenuBtn}"/>
                        <Button x:Name="BtnPractice"  Content="Практика"     Click="Nav_Click" Tag="practice"  Style="{StaticResource MenuBtn}"/>
                        <Button x:Name="BtnCompanies" Content="Компании"     Click="Nav_Click" Tag="companies" Style="{StaticResource MenuBtn}"/>
                        <Button x:Name="BtnApps"      Content="Мои отклики"  Click="Nav_Click" Tag="apps"      Style="{StaticResource MenuBtn}"/>
                        <Button x:Name="BtnMyPractices" Content="Мои практики" Click="Nav_Click" Tag="mypractices" Style="{StaticResource MenuBtn}"/>
                        <Button x:Name="BtnMessages"  Content="Сообщения"    Click="Nav_Click" Tag="messages"  Style="{StaticResource MenuBtn}"/>
                        <Button x:Name="BtnNotif"     Content="Уведомления"  Click="Nav_Click" Tag="notif"     Style="{StaticResource MenuBtn}"/>
                        <Button x:Name="BtnProfile"   Content="Профиль"      Click="Nav_Click" Tag="profile"   Style="{StaticResource MenuBtn}"/>

                        <Button x:Name="BtnMyVacancies"
                                Content="Мои вакансии"
                                Click="Nav_Click" Tag="myvacancies"
                                Style="{StaticResource MenuBtn}"/>

                        <Button x:Name="BtnPracticeApps"
                                Content="Отклики на практику"
                                Click="Nav_Click" Tag="practiceapps"
                                Style="{StaticResource MenuBtn}"/>

                        <Button x:Name="BtnAdmin"
                                Content="Админ-панель"
                                Click="Nav_Click" Tag="admin"
                                Style="{StaticResource MenuBtn}"/>

                        <Button x:Name="BtnManageUsers"
                                Content="Пользователи"
                                Click="Nav_Click" Tag="users"
                                Style="{StaticResource MenuBtn}"/>

                        <Grid x:Name="BtnModVacanciesGrid" Visibility="Collapsed">
                            <Button x:Name="BtnModerationVacancies"
                                    Content="Модерация вакансий"
                                    Click="Nav_Click" Tag="modvacancies"
                                    HorizontalContentAlignment="Left"
                                    Style="{StaticResource MenuBtn}"/>
                            <Border x:Name="ModVacBadge"
                                    Background="#DC2626" CornerRadius="8"
                                    MinWidth="20" Height="20" Padding="6,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,14,0" Visibility="Collapsed">
                                <TextBlock x:Name="ModVacCount" Text="0"
                                           Foreground="White" FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Button x:Name="BtnModerationCompanies"
                                Content="Модерация компаний"
                                Click="Nav_Click" Tag="modcompanies"
                                Style="{StaticResource MenuBtn}"/>

                        <Button x:Name="BtnCompanyDisputes"
                                Content="Оспаривания компаний"
                                Click="Nav_Click" Tag="companydisputes"
                                Style="{StaticResource MenuBtn}"/>

                        <Button x:Name="BtnManageCompanies"
                                Content="Управление компаниями"
                                Click="Nav_Click" Tag="managecompanies"
                                Style="{StaticResource MenuBtn}"/>

                        <Button x:Name="BtnManagePractice"
                                Content="Управление практиками"
                                Click="Nav_Click" Tag="managepractice"
                                Style="{StaticResource MenuBtn}"/>

                        <Button x:Name="BtnModerationPractice"
                                Content="Модерация практик"
                                Click="Nav_Click" Tag="modpractice"
                                Style="{StaticResource MenuBtn}"/>

                        <Button x:Name="BtnModerationReviews"
                                Content="Модерация отзывов"
                                Click="Nav_Click" Tag="modreviews"
                                Style="{StaticResource MenuBtn}"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,0,20">
                        <Button x:Name="BtnLogin" Content="Войти"
                                Click="Login_Click"
                                HorizontalAlignment="Left"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#5B5BF5" FontWeight="Bold"
                                Cursor="Hand"/>
                        <Button x:Name="BtnLogout" Content="Выйти"
                                Click="Logout_Click"
                                HorizontalAlignment="Left"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#DC2626" FontWeight="Bold"
                                Cursor="Hand"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="TopBanner"
                    Grid.Column="1"
                    Background="#FEF3C7"
                    Padding="20,10,20,24"
                    VerticalAlignment="Top"
                    Visibility="Collapsed"
                    Panel.ZIndex="50">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                        <TextBlock Text="⚠ "
                                   FontSize="16"
                                   Foreground="#D97706"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TopBannerText"
                                   Foreground="#D97706"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#5B5BF5" CornerRadius="17"
                            Height="34" MinHeight="34"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <Button x:Name="TopBannerButton"
                                Content="Перейти"
                                Background="Transparent"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="13"
                                Padding="16,0"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="TopBannerButton_Click"/>
                    </Border>

                    <Button Grid.Column="1"
                            Content="Скрыть"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Foreground="#D97706"
                            FontSize="10"
                            Opacity="0.7"
                            Padding="0"
                            Margin="0,0,0,-14"
                            ToolTip="Скрыть уведомление"
                            Click="HideBanner_Click"/>
                </Grid>
            </Border>

            <Frame x:Name="MainFrame" Grid.Column="1"
                   NavigationUIVisibility="Hidden"/>
        </Grid>

        <Border x:Name="SearchOverlay"
                Grid.Row="1"
                Background="#F5F6FA"
                Visibility="Collapsed"
                Panel.ZIndex="100">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock x:Name="SearchTitle"
                               FontSize="20" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="✕ Закрыть"
                            HorizontalAlignment="Right"
                            Style="{StaticResource GhostBtn}"
                            Foreground="#DC2626"
                            Click="CloseSearchOverlay_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SearchResultsPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>