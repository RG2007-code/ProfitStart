<Page x:Class="ProfitStart.PageChat"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="← Назад"
                HorizontalAlignment="Left"
                Style="{StaticResource GhostBtn}"
                Click="Back_Click"/>

        <StackPanel Grid.Row="1" Margin="0,16,0,16">
            <TextBlock x:Name="HeaderText"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Ellipse x:Name="StatusDot"
                         Width="10" Height="10"
                         VerticalAlignment="Center"
                         Fill="#9CA3AF"/>
                <TextBlock x:Name="StatusText"
                           Margin="8,0,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center"
                           Text="—"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource CardBg}"
                CornerRadius="10"
                Padding="16">
            <ScrollViewer x:Name="MessagesScroll"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MessagesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Bg}"
                                    CornerRadius="10"
                                    Padding="12,8"
                                    Margin="{Binding Margin}"
                                    HorizontalAlignment="{Binding Align}"
                                    MaxWidth="500">
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="{Binding Fg}"
                                               TextWrapping="Wrap"
                                               FontSize="13"/>
                                    <TextBlock Text="{Binding Time}"
                                               Foreground="{DynamicResource TextPlaceholder}"
                                               FontSize="10"
                                               Margin="0,4,0,0"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource CardBg}"
                    CornerRadius="10" Height="44">
                <TextBox x:Name="MessageBox"
                         Background="Transparent" BorderThickness="0"
                         Padding="16,0,16,0"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource TextPrimary}"
                         CaretBrush="{DynamicResource TextPrimary}"
                         KeyDown="Message_KeyDown"/>
            </Border>

            <Button Grid.Column="1"
                    Content="Отправить"
                    Width="140" Height="44"
                    Margin="10,0,0,0"
                    Style="{StaticResource PrimaryBtn}"
                    Click="Send_Click"/>
        </Grid>
    </Grid>
</Page>