<Page x:Class="ProfitStart.PageManageSkills"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Управление навыками"
                   FontSize="26" FontWeight="Bold"
                   Margin="0,0,0,24"
                   Foreground="{DynamicResource TextPrimary}"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,20">
            <Border Width="300" Height="44"
                    Background="{DynamicResource CardBg}"
                    CornerRadius="10"
                    BorderBrush="{DynamicResource BorderLine}"
                    BorderThickness="1">
                <TextBox x:Name="NewSkillBox"
                         Background="Transparent" BorderThickness="0"
                         Padding="14,0,0,0"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource TextPrimary}"
                         CaretBrush="{DynamicResource TextPrimary}"/>
            </Border>
            <Button Content="Добавить" Width="140" Height="44"
                    Margin="10,0,0,0"
                    Style="{StaticResource PrimaryBtn}"
                    Click="AddSkill_Click"/>

            <Border Width="280" Height="44"
                    Margin="30,0,0,0"
                    Background="{DynamicResource CardBg}"
                    CornerRadius="10"
                    BorderBrush="{DynamicResource BorderLine}"
                    BorderThickness="1">
                <Grid>
                    <TextBox x:Name="SearchBox"
                             Background="Transparent" BorderThickness="0"
                             Padding="14,0,14,0"
                             VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource TextPrimary}"
                             TextChanged="Search_TextChanged"/>
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Поиск по названию..."
                               Foreground="{DynamicResource TextPlaceholder}"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   x:Name="ErrorText"
                   Foreground="#DC2626" FontSize="12"
                   Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="SkillsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBg}"
                                CornerRadius="10"
                                Padding="20,14" Margin="0,0,0,10">
                            <Grid>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="Bold" FontSize="14"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimary}"/>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding StudentsCount, StringFormat='Студентов: {0}'}"
                                               Foreground="{DynamicResource TextPlaceholder}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0"/>
                                    <TextBlock Text="{Binding VacanciesCount, StringFormat='Вакансий: {0}'}"
                                               Foreground="{DynamicResource TextPlaceholder}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0"/>
                                    <Button Content="Удалить"
                                            Width="100" Height="36"
                                            Style="{StaticResource GhostBtn}"
                                            Foreground="#DC2626"
                                            Tag="{Binding Id}"
                                            Click="Delete_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="4"
                   x:Name="EmptyText"
                   Text="Нет навыков"
                   Foreground="{DynamicResource TextPlaceholder}"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   Margin="0,40,0,0"
                   Visibility="Collapsed"/>

    </Grid>
</Page>