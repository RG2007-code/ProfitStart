<Page x:Class="ProfitStart.PageNotifications"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Уведомления"
                       FontSize="26" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}"/>
            <Button Content="Очистить все"
                    Width="160" Height="40"
                    HorizontalAlignment="Right"
                    Style="{StaticResource GhostBtn}"
                    Foreground="#DC2626"
                    Click="ClearAll_Click"/>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="NotifList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBg}"
                                    CornerRadius="10"
                                    Padding="20" Margin="0,0,0,12"
                                    Cursor="Hand"
                                    Tag="{Binding Id}"
                                    PreviewMouseLeftButtonUp="Notif_Click">
                                <Grid Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0"
                                          Width="40" Height="40"
                                          VerticalAlignment="Center">
                                        <Ellipse Width="40" Height="40"
                                                 Fill="{DynamicResource AccentBgSoft}"/>
                                        <Ellipse Width="40" Height="40"
                                                 Fill="#F59E0B"
                                                 Visibility="{Binding ShowWarning}"/>
                                        <Ellipse Width="40" Height="40"
                                                 Tag="{Binding AvatarData}"
                                                 Loaded="NotifAvatar_Loaded"
                                                 Visibility="{Binding ShowAvatar}"/>
                                        <TextBlock Text="!"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding ShowWarning}"/>
                                    </Grid>

                                    <StackPanel Grid.Column="1"
                                                Margin="15,0,15,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="Bold" FontSize="14"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontSize="12"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Ellipse Grid.Column="2"
                                             Width="10" Height="10"
                                             Fill="#DC2626"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding UnreadMark}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyText"
                           Text="Нет уведомлений"
                           Foreground="{DynamicResource TextPlaceholder}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,40,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>