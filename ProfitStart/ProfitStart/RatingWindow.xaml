<Window x:Class="ProfitStart.RatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рейтинг компании"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource CardBg}"
            CornerRadius="16"
            Margin="10" Padding="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="2"
                              Opacity="0.15" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="Рейтинг компании"
                       FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="Нажмите на звезду"
                       Foreground="{DynamicResource TextPlaceholder}"
                       FontSize="12"
                       Margin="0,4,0,16"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">
                <Button x:Name="S1" Content="★" FontSize="36"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#D1D5DB" Cursor="Hand"
                        Click="Star_Click" Tag="1"/>
                <Button x:Name="S2" Content="★" FontSize="36"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#D1D5DB" Cursor="Hand"
                        Click="Star_Click" Tag="2"/>
                <Button x:Name="S3" Content="★" FontSize="36"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#D1D5DB" Cursor="Hand"
                        Click="Star_Click" Tag="3"/>
                <Button x:Name="S4" Content="★" FontSize="36"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#D1D5DB" Cursor="Hand"
                        Click="Star_Click" Tag="4"/>
                <Button x:Name="S5" Content="★" FontSize="36"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#D1D5DB" Cursor="Hand"
                        Click="Star_Click" Tag="5"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Отмена" Width="120" Height="42"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryBtn}"
                        Click="Cancel_Click"/>
                <Button Content="Сохранить" Width="140" Height="42"
                        Style="{StaticResource PrimaryBtn}"
                        Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>