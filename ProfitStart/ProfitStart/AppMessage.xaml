<Window x:Class="ProfitStart.AppMessage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProfiStart"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource CardBg}"
            CornerRadius="16"
            Margin="10" Padding="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="2"
                              Opacity="0.15" Color="Black"/>
        </Border.Effect>

        <StackPanel>

            <StackPanel Orientation="Horizontal">
                <Border x:Name="IconBorder"
                        Width="40" Height="40" CornerRadius="10"
                        Background="{DynamicResource AccentBgSoft}"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="IconText"
                               Text="i"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#5B5BF5"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText"
                           Text="Информация"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"/>
            </StackPanel>

            <TextBlock x:Name="MessageText"
                       Text=""
                       Foreground="{DynamicResource TextPrimary}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,16,0,24"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Отмена"
                        Width="120" Height="42"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryBtn}"
                        Visibility="Collapsed"
                        Click="Cancel_Click"/>
                <Button x:Name="OkButton"
                        Content="OK"
                        Width="120" Height="42"
                        Style="{StaticResource PrimaryBtn}"
                        Click="Ok_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>