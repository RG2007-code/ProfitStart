<Page x:Class="ProfitStart.PageApplyPractice"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Button Content="← Назад"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,20"
                        Style="{StaticResource GhostBtn}"
                        Click="Back_Click"/>

                <TextBlock Text="Отклик на практику"
                           FontSize="26" FontWeight="Bold"
                           Margin="0,0,0,8"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock x:Name="RequestTitleText"
                           Foreground="#5B5BF5"
                           FontSize="14"
                           Margin="0,0,0,24"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Сопроводительное сообщение"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,0,6"/>
                <Border Background="{DynamicResource CardBg}"
                        CornerRadius="10" MinHeight="160">
                    <TextBox x:Name="MessageBox"
                             Background="Transparent" BorderThickness="0"
                             Padding="14,10"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             MaxLength="500"
                             VerticalContentAlignment="Top"
                             Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource TextPrimary}"
                             TextChanged="Message_TextChanged"/>
                </Border>

                <TextBlock x:Name="CounterText" Text="0 / 500"
                           Foreground="{DynamicResource TextPlaceholder}"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           Margin="0,4,0,0"/>

                <TextBlock x:Name="ErrorText" Foreground="#DC2626"
                           FontSize="12" Margin="0,12,0,0"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="Отмена" Width="130" Height="44"
                            Margin="0,0,10,0"
                            Style="{StaticResource SecondaryBtn}"
                            Click="Back_Click"/>
                    <Button Content="Отправить отклик" Width="200" Height="44"
                            Style="{StaticResource PrimaryBtn}"
                            Click="Send_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>