<Window x:Class="ProfitStart.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProfiStart — Регистрация"
        Height="760" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PageBg}">
    <Grid>
        <Border Background="{DynamicResource CardBg}"
                CornerRadius="16"
                Width="500" Padding="32" Margin="20"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Регистрация"
                               FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Создайте аккаунт ProfiStart"
                               Foreground="{DynamicResource TextMuted}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,20"/>

                    <TextBlock Text="Роль"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,6"/>
                    <Border Background="{DynamicResource AccentBgSoft}"
                            CornerRadius="10" Height="44">
                        <ComboBox x:Name="RoleBox"
                                  Style="{StaticResource FlatCombo}"
                                  SelectedIndex="0"
                                  SelectionChanged="Role_Changed">
                            <ComboBoxItem Content="Студент"  Tag="Student"/>
                            <ComboBoxItem Content="Компания" Tag="Employer"/>
                            <ComboBoxItem Content="Админ"    Tag="Admin"/>
                        </ComboBox>
                    </Border>

                    <TextBlock Text="Телефон"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,16,0,6"/>
                    <Border Background="{DynamicResource AccentBgSoft}"
                            CornerRadius="10" Height="44">
                        <TextBox x:Name="PhoneBox" Background="Transparent"
                                 BorderThickness="0" Padding="14,0,0,0"
                                 VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource TextPrimary}"
                                 CaretBrush="{DynamicResource TextPrimary}"
                                 PreviewTextInput="PhoneInput"
                                 MaxLength="12" Text="+7"/>
                    </Border>

                    <TextBlock Text="Email"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,16,0,6"/>
                    <Border Background="{DynamicResource AccentBgSoft}"
                            CornerRadius="10" Height="44">
                        <TextBox x:Name="EmailBox" Background="Transparent"
                                 BorderThickness="0" Padding="14,0,0,0"
                                 VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource TextPrimary}"
                                 CaretBrush="{DynamicResource TextPrimary}"/>
                    </Border>

                    <TextBlock Text="Пароль"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,16,0,6"/>
                    <Border Background="{DynamicResource AccentBgSoft}"
                            CornerRadius="10" Height="44">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <PasswordBox x:Name="PasswordBox"
                                         Grid.Column="0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="14,0,0,0"
                                         Foreground="{DynamicResource TextPrimary}"
                                         CaretBrush="{DynamicResource TextPrimary}"
                                         VerticalContentAlignment="Center"/>

                            <TextBox x:Name="PasswordPlain"
                                     Grid.Column="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="14,0,0,0"
                                     VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource TextPrimary}"
                                     CaretBrush="{DynamicResource TextPrimary}"
                                     Visibility="Collapsed"/>

                            <Button x:Name="ToggleBtn1"
                                    Grid.Column="1"
                                    Content="Показать"
                                    MinWidth="80"
                                    Margin="0,0,6,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    FontSize="12"
                                    Foreground="#5B5BF5"
                                    ToolTip="Показать пароль"
                                    Click="TogglePassword_Click"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Повтор пароля"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,16,0,6"/>
                    <Border Background="{DynamicResource AccentBgSoft}"
                            CornerRadius="10" Height="44">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <PasswordBox x:Name="Password2Box"
                                         Grid.Column="0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="14,0,0,0"
                                         Foreground="{DynamicResource TextPrimary}"
                                         CaretBrush="{DynamicResource TextPrimary}"
                                         VerticalContentAlignment="Center"/>

                            <TextBox x:Name="Password2Plain"
                                     Grid.Column="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="14,0,0,0"
                                     VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource TextPrimary}"
                                     CaretBrush="{DynamicResource TextPrimary}"
                                     Visibility="Collapsed"/>

                            <Button x:Name="ToggleBtn2"
                                    Grid.Column="1"
                                    Content="Показать"
                                    MinWidth="80"
                                    Margin="0,0,6,6"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    FontSize="12"
                                    Foreground="#5B5BF5"
                                    ToolTip="Показать пароль"
                                    Click="TogglePassword2_Click"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="NameLabel" Text="ФИО"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,16,0,6"/>
                    <Border Background="{DynamicResource AccentBgSoft}"
                            CornerRadius="10" Height="44">
                        <TextBox x:Name="NameBox" Background="Transparent"
                                 BorderThickness="0" Padding="14,0,0,0"
                                 VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource TextPrimary}"
                                 CaretBrush="{DynamicResource TextPrimary}"/>
                    </Border>

                    <StackPanel x:Name="StudentPanel">
                        <TextBlock Text="Курс"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,16,0,6"/>
                        <Border Background="{DynamicResource AccentBgSoft}"
                                CornerRadius="10" Height="44">
                            <TextBox x:Name="CourseBox"
                                     Background="Transparent"
                                     BorderThickness="0" Padding="14,0,0,0"
                                     VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource TextPrimary}"
                                     CaretBrush="{DynamicResource TextPrimary}"
                                     PreviewTextInput="DigitsOnly"
                                     MaxLength="1"/>
                        </Border>

                        <TextBlock Text="Направление подготовки"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,16,0,6"/>
                        <Border Background="{DynamicResource AccentBgSoft}"
                                CornerRadius="10" Height="44">
                            <TextBox x:Name="DirectionBox"
                                     Background="Transparent"
                                     BorderThickness="0" Padding="14,0,0,0"
                                     VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource TextPrimary}"
                                     CaretBrush="{DynamicResource TextPrimary}"/>
                        </Border>

                        <TextBlock Text="Номер студенческого (только цифры)"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,16,0,6"/>
                        <Border Background="{DynamicResource AccentBgSoft}"
                                CornerRadius="10" Height="44">
                            <TextBox x:Name="CardBox"
                                     Background="Transparent"
                                     BorderThickness="0" Padding="14,0,0,0"
                                     VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource TextPrimary}"
                                     CaretBrush="{DynamicResource TextPrimary}"
                                     PreviewTextInput="DigitsOnly"
                                     MaxLength="20"/>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="CompanyPanel" Visibility="Collapsed">
                        <TextBlock Text="ОГРН (13 цифр)"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,16,0,6"/>
                        <Border Background="{DynamicResource AccentBgSoft}"
                                CornerRadius="10" Height="44">
                            <TextBox x:Name="OgrnBox"
                                     Background="Transparent"
                                     BorderThickness="0" Padding="14,0,0,0"
                                     VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource TextPrimary}"
                                     CaretBrush="{DynamicResource TextPrimary}"
                                     PreviewTextInput="DigitsOnly"
                                     MaxLength="13"/>
                        </Border>

                        <TextBlock Text="ИНН (10 или 12 цифр)"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,16,0,6"/>
                        <Border Background="{DynamicResource AccentBgSoft}"
                                CornerRadius="10" Height="44">
                            <TextBox x:Name="InnBox"
                                     Background="Transparent"
                                     BorderThickness="0" Padding="14,0,0,0"
                                     VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource TextPrimary}"
                                     CaretBrush="{DynamicResource TextPrimary}"
                                     PreviewTextInput="DigitsOnly"
                                     MaxLength="12"/>
                        </Border>

                        <TextBlock Text="Сфера деятельности"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,16,0,6"/>
                        <Border Background="{DynamicResource AccentBgSoft}"
                                CornerRadius="10" Height="44">
                            <TextBox x:Name="CompanyDirBox"
                                     Background="Transparent"
                                     BorderThickness="0" Padding="14,0,0,0"
                                     VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource TextPrimary}"
                                     CaretBrush="{DynamicResource TextPrimary}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AdminPanel" Visibility="Collapsed">
                        <TextBlock Text="Удостоверение админа (только цифры)"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,16,0,6"/>
                        <Border Background="{DynamicResource AccentBgSoft}"
                                CornerRadius="10" Height="44">
                            <TextBox x:Name="AdminCardBox"
                                     Background="Transparent"
                                     BorderThickness="0" Padding="14,0,0,0"
                                     VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource TextPrimary}"
                                     CaretBrush="{DynamicResource TextPrimary}"
                                     PreviewTextInput="DigitsOnly"
                                     MaxLength="20"/>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="ErrorText" Foreground="#DC2626"
                               FontSize="12" Margin="0,12,0,0"
                               TextWrapping="Wrap"/>

                    <Button Content="Создать аккаунт" Height="46"
                            Margin="0,20,0,0"
                            Style="{StaticResource PrimaryBtn}"
                            Click="Register_Click"/>

                    <Button Content="Уже есть аккаунт? Войти"
                            Height="42" Margin="0,10,0,0"
                            Style="{StaticResource GhostBtn}"
                            Click="GoLogin_Click"/>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>