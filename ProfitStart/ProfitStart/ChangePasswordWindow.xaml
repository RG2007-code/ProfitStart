<Window x:Class="ProfitStart.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена пароля"
        Width="480"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PageBg}">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Background="{DynamicResource CardBg}"
                    CornerRadius="16"
                    Width="420" Padding="28"
                    Margin="10"
                    HorizontalAlignment="Center">
                <StackPanel>

                    <TextBlock Text="Смена пароля"
                               FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Text="Текущий пароль"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,6"/>
                    <Border Background="{DynamicResource AccentBgSoft}"
                            CornerRadius="10" Height="44">
                        <PasswordBox x:Name="CurrentPasswordBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="14,0,0,0"
                                     VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource TextPrimary}"
                                     CaretBrush="{DynamicResource TextPrimary}"/>
                    </Border>

                    <TextBlock Text="Новый пароль"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,16,0,6"/>
                    <Border Background="{DynamicResource AccentBgSoft}"
                            CornerRadius="10" Height="44">
                        <PasswordBox x:Name="NewPasswordBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="14,0,0,0"
                                     VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource TextPrimary}"
                                     CaretBrush="{DynamicResource TextPrimary}"/>
                    </Border>

                    <TextBlock Text="Повторите новый пароль"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,16,0,6"/>
                    <Border Background="{DynamicResource AccentBgSoft}"
                            CornerRadius="10" Height="44">
                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="14,0,0,0"
                                     VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource TextPrimary}"
                                     CaretBrush="{DynamicResource TextPrimary}"/>
                    </Border>

                    <TextBlock x:Name="ErrorText"
                               Foreground="#DC2626"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Content="Отмена"
                                Width="130" Height="44"
                                Margin="0,0,10,0"
                                Style="{StaticResource SecondaryBtn}"
                                Click="Cancel_Click"/>
                        <Button Content="Сменить пароль"
                                Width="180" Height="44"
                                Style="{StaticResource PrimaryBtn}"
                                Click="Save_Click"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>