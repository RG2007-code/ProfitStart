<Page x:Class="ProfitStart.PagePracticeCard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Button Content="← Назад"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,20"
                        Style="{StaticResource GhostBtn}"
                        Click="Back_Click"/>

                <Border Background="{DynamicResource CardBg}"
                        CornerRadius="10"
                        Padding="24" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0"
                              Width="64" Height="64"
                              VerticalAlignment="Center">
                            <Ellipse Width="64" Height="64"
                                     Fill="{DynamicResource AccentBgSoft}"/>
                            <Ellipse x:Name="AvatarBig"
                                     Width="64" Height="64"/>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    Margin="20,0,16,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText"
                                       FontSize="24" FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="CompanyText"
                                       Foreground="#5B5BF5"
                                       FontSize="14"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Откликнуться"
                                Width="180" Height="44"
                                VerticalAlignment="Center"
                                Style="{StaticResource PrimaryBtn}"
                                Click="Apply_Click"/>
                    </Grid>
                </Border>

                <Border Background="#DCFCE7" CornerRadius="10"
                        Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock x:Name="MatchText"
                                   Foreground="#16A34A" FontWeight="Bold"/>
                        <TextBlock Text="Ваши навыки соответствуют требованиям"
                                   Foreground="#16A34A" FontSize="12"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBg}"
                        CornerRadius="10"
                        Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Направление"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="12"/>
                            <TextBlock x:Name="DirectionText"
                                       FontWeight="Bold" FontSize="14"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Длительность"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="12"/>
                            <TextBlock x:Name="DurationText"
                                       FontWeight="Bold" FontSize="14"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Оплата"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="12"/>
                            <TextBlock x:Name="PaymentText"
                                       FontWeight="Bold" FontSize="14"
                                       Foreground="#16A34A"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Требуемые навыки"
                           FontSize="18" FontWeight="Bold"
                           Margin="0,0,0,12"
                           Foreground="{DynamicResource TextPrimary}"/>
                <WrapPanel x:Name="SkillsPanel" Margin="0,0,0,20"/>

                <TextBlock Text="Описание" FontSize="18" FontWeight="Bold"
                           Margin="0,0,0,8"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="DescText"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,0,20"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>