<Page x:Class="ProfitStart.PageStudentProfile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Button Content="← Назад"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,20"
                        Style="{StaticResource GhostBtn}"
                        Click="Back_Click"/>

                <Border Background="{DynamicResource CardBg}"
                        CornerRadius="10"
                        Padding="24" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="80" Height="80">
                            <Ellipse Width="80" Height="80"
                                     Fill="{DynamicResource AccentBgSoft}"/>
                            <Ellipse x:Name="AvatarBig" Width="80" Height="80"/>
                        </Grid>
                        <StackPanel Margin="20,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="NameText"
                                       FontWeight="Bold" FontSize="20"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="SubtitleText"
                                       Foreground="{DynamicResource TextMuted}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Направление"
                           FontWeight="Bold" Margin="0,8,0,6"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="DirText"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Text="Навыки"
                           FontWeight="Bold" Margin="0,20,0,12"
                           Foreground="{DynamicResource TextPrimary}"/>
                <WrapPanel x:Name="SkillsPanel"/>

               
                <TextBlock Text="Резюме"
                           FontWeight="Bold" Margin="0,20,0,6"
                           Foreground="{DynamicResource TextPrimary}"/>
                <Border Background="{DynamicResource CardBg}"
                        CornerRadius="10"
                        Padding="20"
                        BorderBrush="{DynamicResource BorderLine}"
                        BorderThickness="1" MinHeight="200">
                    <StackPanel>
                        <TextBlock x:Name="ResumeText"
                                   Foreground="{DynamicResource TextPrimary}"
                                   TextWrapping="Wrap"
                                   FontSize="13"/>

                        
                        <Border Height="1"
                                Background="{DynamicResource BorderLine}"
                                Margin="0,16,0,16"/>

                       
                        <TextBlock x:Name="PdfNoText"
                                   Text="PDF-резюме не загружено"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="13"
                                   Margin="0,0,0,12"/>

                        <StackPanel x:Name="PdfInfo"
                                    Visibility="Collapsed"
                                    Margin="0,0,0,12">
                            <TextBlock x:Name="PdfNameText"
                                       FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="PdfDateText"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="12"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PdfOpenBtn"
                                    Content="Открыть PDF"
                                    Width="150" Height="38"
                                    Style="{StaticResource PrimaryBtn}"
                                    Visibility="Collapsed"
                                    Click="PdfOpen_Click"/>

                            <Button x:Name="PdfSaveBtn"
                                    Content="Скачать PDF"
                                    Width="150" Height="38"
                                    Margin="10,0,0,0"
                                    Style="{StaticResource SecondaryBtn}"
                                    Visibility="Collapsed"
                                    Click="PdfSave_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

               
                <TextBlock Text="Паспорт"
                           FontWeight="Bold" Margin="0,20,0,6"
                           Foreground="{DynamicResource TextPrimary}"/>
                <Border Background="{DynamicResource CardBg}"
                        CornerRadius="10"
                        Height="250"
                        BorderBrush="{DynamicResource BorderLine}"
                        BorderThickness="1">
                    <Grid>
                        <Border x:Name="PassportPreview" Margin="8"/>
                        <TextBlock x:Name="PassportHint"
                                   Text="Паспорт не загружен"
                                   Foreground="{DynamicResource TextPlaceholder}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

               
                <StackPanel x:Name="DiplomaBlock" Visibility="Collapsed">
                    <TextBlock Text="Диплом"
                               FontWeight="Bold" Margin="0,20,0,6"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <Border Background="{DynamicResource CardBg}"
                            CornerRadius="10"
                            Height="250"
                            BorderBrush="{DynamicResource BorderLine}"
                            BorderThickness="1">
                        <Grid>
                            <Border x:Name="DiplomaPreview" Margin="8"/>
                            <TextBlock x:Name="DiplomaHint"
                                       Text="Диплом не загружен"
                                       Foreground="{DynamicResource TextPlaceholder}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>