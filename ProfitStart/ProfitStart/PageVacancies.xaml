<Page x:Class="ProfitStart.PageVacancies"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Вакансии"
                   FontSize="26" FontWeight="Bold" Margin="0,0,0,16"
                   Foreground="{DynamicResource TextPrimary}"/>

        <Border Grid.Row="1" Background="{DynamicResource CardBg}"
                CornerRadius="22"
                Height="44" Margin="0,0,0,16">
            <Grid>
                <TextBox x:Name="SearchBox"
                         Background="Transparent" BorderThickness="0"
                         Padding="16,0,16,0"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource TextPrimary}"
                         CaretBrush="{DynamicResource TextPrimary}"
                         TextChanged="Search_TextChanged"/>
                <TextBlock x:Name="SearchPlaceholder"
                           Text="Поиск по вакансиям..."
                           Foreground="{DynamicResource TextPlaceholder}"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Тип:" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" Margin="0,0,8,0"/>
                <ComboBox x:Name="TypeFilter"
                          Width="170" Height="40"
                          Style="{StaticResource FlatCombo}"
                          SelectedIndex="0"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Все"/>
                    <ComboBoxItem Content="Стажировка"/>
                    <ComboBoxItem Content="Работа"/>
                    <ComboBoxItem Content="Практика"/>
                </ComboBox>

                <TextBlock Text="Зарплата:" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" Margin="24,0,8,0"/>
                <ComboBox x:Name="SalaryFilter"
                          Width="200" Height="40"
                          Style="{StaticResource FlatCombo}"
                          SelectedIndex="0"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Без сортировки"/>
                    <ComboBoxItem Content="Сначала дорогие"/>
                    <ComboBoxItem Content="Сначала дешёвые"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="VacancyList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBg}"
                                CornerRadius="10" Padding="20"
                                Margin="0,0,0,12"
                                MouseLeftButtonUp="Vacancy_Click"
                                Tag="{Binding Id}" Cursor="Hand">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="48" Height="48" VerticalAlignment="Center">
                                        <Ellipse Width="48" Height="48"
                                                 Fill="{DynamicResource AccentBgSoft}"/>
                                        <Ellipse Width="48" Height="48"
                                                 Tag="{Binding AvatarData}"
                                                 Loaded="VacancyAvatar_Loaded"/>
                                    </Grid>
                                    <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="Bold" FontSize="15"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding SalaryText}"
                                                   Foreground="#92400E" FontSize="12"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                              
                                <Border Background="#DCFCE7" CornerRadius="12"
                                        Padding="10,4"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Visibility="{Binding MatchVisibility}">
                                    <TextBlock Text="{Binding Match}"
                                               Foreground="#16A34A" FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>