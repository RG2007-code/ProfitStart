<Page x:Class="ProfitStart.PageCompanyDispute"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Button Content="← Назад"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,12"
                    Style="{StaticResource GhostBtn}"
                    Click="Back_Click"/>

            <TextBlock Text="Оспаривание компании"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">

                <Border Background="{DynamicResource CardBg}"
                        CornerRadius="10"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Компания"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="12"/>
                        <TextBlock x:Name="CompanyNameText"
                                   FontSize="18" FontWeight="Bold"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="CompanyInfoText"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="12"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBg}"
                        CornerRadius="10"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Причина удаления"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="12"/>
                        <TextBlock x:Name="RejectReasonText"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#DC2626"
                                   FontSize="14"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBg}"
                        CornerRadius="10"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Оспаривание от компании"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="12"/>
                        <TextBlock x:Name="DisputeText"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="14"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorText"
                           Foreground="#DC2626"
                           FontSize="12"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,0">
                    <Button Content="Одобрить"
                            Width="160" Height="44"
                            Margin="0,0,10,0"
                            Style="{StaticResource PrimaryBtn}"
                            Click="Approve_Click"/>
                    <Button Content="Удалить окончательно"
                            Width="220" Height="44"
                            Style="{StaticResource GhostBtn}"
                            Foreground="#DC2626"
                            Click="DeleteForever_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>