<Page x:Class="ProfitStart.PageVacancyCard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="64" Height="64" VerticalAlignment="Center">
                            <Ellipse Width="64" Height="64"
                                     Fill="{DynamicResource AccentBgSoft}"/>
                            <Ellipse x:Name="AvatarBig"
                                     Width="64" Height="64"/>
                        </Grid>
                        <StackPanel Margin="16,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText"
                                       FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="SubText"
                                       Foreground="#5B5BF5"
                                       FontSize="14"
                                       Cursor="Hand"
                                       Margin="0,4,0,0"
                                       MouseLeftButtonUp="CompanyText_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Content="Откликнуться"
                            Width="180" Height="44"
                            Style="{StaticResource PrimaryBtn}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Click="Apply_Click"/>
                </Grid>

                <Border Background="#DCFCE7" CornerRadius="10"
                        Padding="20" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock x:Name="MatchText"
                                   Foreground="#16A34A" FontWeight="Bold"/>
                        <TextBlock Text="Ваши навыки соответствуют требованиям"
                                   Foreground="#16A34A" FontSize="12"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="SalaryBlock"
                        Background="#FEF3C7" CornerRadius="10"
                        Padding="16" Margin="0,16,0,0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💰" FontSize="16"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Оплата:" FontWeight="Bold"
                                   Foreground="#92400E"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="SalaryText"
                                   Foreground="#92400E"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Описание" FontSize="18" FontWeight="Bold"
                           Margin="0,24,0,8"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="DescText" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Text="Требования" FontSize="18" FontWeight="Bold"
                           Margin="0,24,0,8"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="ReqText" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimary}"/>

                <StackPanel x:Name="SkillsBlock">
                    <TextBlock Text="Требуемые навыки"
                               FontSize="18" FontWeight="Bold"
                               Margin="0,24,0,12"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <WrapPanel x:Name="SkillsPanel"/>
                </StackPanel>

                <Button Content="О компании"
                        Width="180" Height="44"
                        Margin="0,32,0,0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource SecondaryBtn}"
                        Click="Company_Click"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>