<Page x:Class="ProfitStart.PagePracticeApplications"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Отклики на практики"
                       FontSize="26" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}"/>

            <Border Background="{DynamicResource CardBg}"
                    CornerRadius="22"
                    Height="44" Width="220"
                    HorizontalAlignment="Right">
                <ComboBox x:Name="StatusFilter"
                          Style="{StaticResource FlatCombo}"
                          SelectedIndex="0"
                          SelectionChanged="StatusFilter_Changed">
                    <ComboBoxItem Content="Все"/>
                    <ComboBoxItem Content="Ожидают"/>
                    <ComboBoxItem Content="Одобрены"/>
                    <ComboBoxItem Content="Отклонены"/>
                </ComboBox>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AppsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBg}"
                                CornerRadius="10"
                                Padding="20" Margin="0,0,0,12">
                            <Grid>
                                <StackPanel Orientation="Horizontal">

                                    
                                    <Grid Width="48" Height="48"
                                          VerticalAlignment="Top"
                                          Margin="0,0,14,0">
                                        <Ellipse Width="48" Height="48"
                                                 Fill="{DynamicResource AccentBgSoft}"/>
                                        <Ellipse Width="48" Height="48"
                                                 Tag="{Binding AvatarData}"
                                                 Loaded="StudentAvatar_Loaded"/>
                                    </Grid>

                                    <StackPanel>
                                        <TextBlock Text="{Binding StudentName}"
                                                   FontWeight="Bold" FontSize="15"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding PracticeTitle}"
                                                   Foreground="#5B5BF5" FontSize="13"
                                                   Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Message}"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="{Binding StatusColor}"
                                                   FontSize="12"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">

                                    
                                    <Button Content="Профиль студента"
                                            Width="170" Height="38"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryBtn}"
                                            Tag="{Binding StudentId}"
                                            Visibility="{Binding ProfileVisibility}"
                                            Click="StudentProfile_Click"/>

                                   
                                    <Button Content="Написать"
                                            Width="110" Height="38"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource GhostBtn}"
                                            Tag="{Binding StudentId}"
                                            Visibility="{Binding CanMessage}"
                                            Click="WriteMessage_Click"/>

                                    
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding ButtonsVisibility}">
                                        <Button Content="Одобрить"
                                                Width="120" Height="38"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource PrimaryBtn}"
                                                Tag="{Binding Id}"
                                                Click="Approve_Click"/>
                                        <Button Content="Отклонить"
                                                Width="120" Height="38"
                                                Style="{StaticResource SecondaryBtn}"
                                                Tag="{Binding Id}"
                                                Click="Reject_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="EmptyText"
                   Grid.Row="1"
                   Text="Нет откликов на практики"
                   Foreground="{DynamicResource TextPlaceholder}"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</Page>