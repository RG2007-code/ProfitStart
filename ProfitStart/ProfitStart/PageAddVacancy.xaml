<Page x:Class="ProfitStart.PageAddVacancy"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Button Content="← Назад"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,20"
                        Style="{StaticResource GhostBtn}"
                        Click="Back_Click"/>

                <TextBlock Text="Добавить вакансию"
                           FontSize="26" FontWeight="Bold"
                           Margin="0,0,0,24"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Text="Название"
                           Foreground="{DynamicResource TextMuted}"
                           Margin="0,0,0,6"/>
                <Border Background="{DynamicResource CardBg}"
                        CornerRadius="10" Height="44"
                        BorderBrush="{DynamicResource BorderLine}"
                        BorderThickness="1">
                    <TextBox x:Name="TitleBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="14,0,0,0"
                             VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource TextPrimary}"/>
                </Border>

                <TextBlock Text="Тип"
                           Foreground="{DynamicResource TextMuted}"
                           Margin="0,16,0,6"/>
                <Border Background="{DynamicResource CardBg}"
                        CornerRadius="10" Height="44"
                        BorderBrush="{DynamicResource BorderLine}"
                        BorderThickness="1">
                    <ComboBox x:Name="TypeBox"
                              Style="{StaticResource FlatCombo}"
                              SelectedIndex="0"
                              SelectionChanged="TypeChanged">
                        <ComboBoxItem Content="Стажировка"/>
                        <ComboBoxItem Content="Работа"/>
                        <ComboBoxItem Content="Практика"/>
                    </ComboBox>
                </Border>

                <TextBlock Text="Описание"
                           Foreground="{DynamicResource TextMuted}"
                           Margin="0,16,0,6"/>
                <Border Background="{DynamicResource CardBg}"
                        CornerRadius="10" MinHeight="100"
                        BorderBrush="{DynamicResource BorderLine}"
                        BorderThickness="1">
                    <TextBox x:Name="DescBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="14,10"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource TextPrimary}"/>
                </Border>

                <TextBlock Text="Требования"
                           Foreground="{DynamicResource TextMuted}"
                           Margin="0,16,0,6"/>
                <Border Background="{DynamicResource CardBg}"
                        CornerRadius="10" MinHeight="100"
                        BorderBrush="{DynamicResource BorderLine}"
                        BorderThickness="1">
                    <TextBox x:Name="ReqBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="14,10"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource TextPrimary}"/>
                </Border>

                <TextBlock Text="Оплата"
                           Foreground="{DynamicResource TextMuted}"
                           Margin="0,16,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource CardBg}"
                            CornerRadius="10" Height="44"
                            BorderBrush="{DynamicResource BorderLine}"
                            BorderThickness="1">
                        <TextBox x:Name="SalaryBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="14,0,0,0"
                                 VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource TextPrimary}"
                                 CaretBrush="{DynamicResource TextPrimary}"/>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{DynamicResource CardBg}"
                            CornerRadius="10" Height="44"
                            Width="200" Margin="10,0,0,0"
                            BorderBrush="{DynamicResource BorderLine}"
                            BorderThickness="1">
                        <ComboBox x:Name="SalaryUnit"
                                  Style="{StaticResource FlatCombo}"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="рублей/час"/>
                            <ComboBoxItem Content="рублей/месяц"/>
                        </ComboBox>
                    </Border>
                </Grid>

                <TextBlock Text="Требуемые навыки (обязательно)"
                           Foreground="{DynamicResource TextMuted}"
                           Margin="0,16,0,10"/>
                <WrapPanel x:Name="SkillsPanel" Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource CardBg}"
                            CornerRadius="10"
                            BorderBrush="{DynamicResource BorderLine}"
                            BorderThickness="1"
                            Height="40">
                        <TextBox x:Name="SkillInput"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="14,0,0,0"
                                 VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource TextPrimary}"
                                 CaretBrush="{DynamicResource TextPrimary}"
                                 GotFocus="SkillInput_GotFocus"
                                 TextChanged="SkillInput_TextChanged"
                                 KeyDown="SkillInput_KeyDown"/>
                    </Border>

                    <Button Grid.Column="1"
                            Content="Добавить"
                            Width="120" Height="40"
                            Margin="10,0,0,0"
                            Style="{StaticResource PrimaryBtn}"
                            Click="AddSkill_Click"/>
                </Grid>

                <Popup x:Name="SkillsPopup"
                       PlacementTarget="{Binding ElementName=SkillInput}"
                       Placement="Bottom"
                       StaysOpen="True"
                       AllowsTransparency="True"
                       IsOpen="False"
                       Focusable="False"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource CardBg}"
                            CornerRadius="10"
                            MinWidth="380" MaxWidth="380"
                            MaxHeight="240"
                            Margin="0,4,0,0"
                            Padding="4"
                            BorderBrush="{DynamicResource BorderLine}"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2"
                                              Opacity="0.15" Color="Black"/>
                        </Border.Effect>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SkillsSuggestList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent"
                                                CornerRadius="6"
                                                Padding="14,10"
                                                Cursor="Hand"
                                                PreviewMouseLeftButtonDown="SkillSuggest_Click"
                                                Tag="{Binding}">
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       FontSize="14"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Popup>

                <TextBlock Text="Аватар вакансии"
                           Foreground="{DynamicResource TextMuted}"
                           Margin="0,16,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <Border Width="80" Height="80" CornerRadius="12"
                            Background="{DynamicResource AccentBgSoft}">
                        <Border x:Name="PreviewAvatar"
                                Width="80" Height="80" CornerRadius="12"/>
                    </Border>
                    <Button Content="Загрузить"
                            Height="40" Width="140"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource PrimaryBtn}"
                            Click="UploadAvatar_Click"/>
                </StackPanel>

                <TextBlock x:Name="ErrorText" Foreground="#DC2626"
                           FontSize="12" Margin="0,12,0,0"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="Отмена" Width="130" Height="44"
                            Margin="0,0,10,0"
                            Style="{StaticResource SecondaryBtn}"
                            Click="Back_Click"/>
                    <Button Content="Отправить на модерацию"
                            Width="220" Height="44"
                            Style="{StaticResource PrimaryBtn}"
                            Click="Save_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>