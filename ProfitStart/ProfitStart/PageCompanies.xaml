<Page x:Class="ProfitStart.PageCompanies"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Компании-партнёры"
                   FontSize="26" FontWeight="Bold" Margin="0,0,0,16"
                   Foreground="{DynamicResource TextPrimary}"/>

        <Border Grid.Row="1" Background="{DynamicResource CardBg}"
                CornerRadius="22" Height="44" Margin="0,0,0,16">
            <Grid>
                <TextBox x:Name="SearchBox"
                         Background="Transparent" BorderThickness="0"
                         Padding="16,0,16,0"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource TextPrimary}"
                         CaretBrush="{DynamicResource TextPrimary}"
                         TextChanged="Search_TextChanged"/>
                <TextBlock x:Name="SearchPlaceholder"
                           Text="Поиск по компаниям..."
                           Foreground="{DynamicResource TextPlaceholder}"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Рейтинг:" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMuted}" Margin="0,0,8,0"/>
            <ComboBox x:Name="RatingFilter"
                      Width="200" Height="40"
                      Style="{StaticResource FlatCombo}"
                      SelectedIndex="0"
                      SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Все"/>
                <ComboBoxItem Content="5 звёзд"/>
                <ComboBoxItem Content="4+ звезды"/>
                <ComboBoxItem Content="3+ звезды"/>
            </ComboBox>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CompanyList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBg}"
                                CornerRadius="10"
                                Width="240" Height="230"
                                Padding="20" Margin="0,0,16,16"
                                Cursor="Hand" Tag="{Binding Id}"
                                MouseLeftButtonUp="Company_Click">
                            <StackPanel>
                                <Grid Width="56" Height="56" HorizontalAlignment="Left">
                                    <Ellipse Width="56" Height="56"
                                             Fill="{DynamicResource AccentBgSoft}"/>
                                    <Ellipse Width="56" Height="56"
                                             Tag="{Binding AvatarData}"
                                             Loaded="CompanyAvatar_Loaded"/>
                                </Grid>

                                <TextBlock Text="{Binding Name}"
                                           FontWeight="Bold" FontSize="14"
                                           Margin="0,14,0,4" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimary}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Stars}"
                                               Foreground="#F59E0B"
                                               FontSize="14"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding RatingText}"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="11"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="{Binding Direction}"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>