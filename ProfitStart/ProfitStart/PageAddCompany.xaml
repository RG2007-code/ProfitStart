<Page x:Class="ProfitStart.PageAddCompany"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F6FA">
    <Grid Margin="30,25">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Добавить компанию"
                           FontSize="26" FontWeight="Bold"
                           Margin="0,0,0,24"/>

                <TextBlock Text="Название" Foreground="#374151" Margin="0,0,0,6"/>
                <Border Background="White" CornerRadius="10" Height="44">
                    <TextBox x:Name="NameBox" Background="Transparent"
                             BorderThickness="0" Padding="14,0,0,0"
                             VerticalContentAlignment="Center"/>
                </Border>

                <TextBlock Text="ОГРН (13 цифр)" Foreground="#374151"
                           Margin="0,16,0,6"/>
                <Border Background="White" CornerRadius="10" Height="44">
                    <TextBox x:Name="OgrnBox" Background="Transparent"
                             BorderThickness="0" Padding="14,0,0,0"
                             VerticalContentAlignment="Center"
                             PreviewTextInput="DigitsOnly"
                             MaxLength="13"/>
                </Border>

                <TextBlock Text="Сфера деятельности"
                           Foreground="#374151" Margin="0,16,0,6"/>
                <Border Background="White" CornerRadius="10" Height="44">
                    <TextBox x:Name="DirBox" Background="Transparent"
                             BorderThickness="0" Padding="14,0,0,0"
                             VerticalContentAlignment="Center"/>
                </Border>

                <TextBlock Text="О компании" Foreground="#374151"
                           Margin="0,16,0,6"/>
                <Border Background="White" CornerRadius="10" MinHeight="120">
                    <TextBox x:Name="DescBox" Background="Transparent"
                             BorderThickness="0" Padding="14,10"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalContentAlignment="Top"/>
                </Border>

                <TextBlock Text="Аватар компании" Foreground="#374151"
                           Margin="0,16,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <Border Width="80" Height="80" CornerRadius="12"
                            Background="#EEF2FF">
                        <Border x:Name="PreviewAvatar"
                                Width="80" Height="80" CornerRadius="12"/>
                    </Border>
                    <Button Content="Загрузить"
                            Height="40" Width="140"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource PrimaryBtn}"
                            Click="UploadAvatar_Click"/>
                </StackPanel>

                <TextBlock x:Name="ErrorText" Foreground="#DC2626"
                           FontSize="12" Margin="0,12,0,0"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="Отмена" Width="130" Height="44"
                            Margin="0,0,10,0"
                            Style="{StaticResource SecondaryBtn}"
                            Click="Cancel_Click"/>
                    <Button Content="Отправить на модерацию"
                            Width="220" Height="44"
                            Style="{StaticResource PrimaryBtn}"
                            Click="Save_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>