<Window x:Class="ProfitStart.BanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Бан пользователя"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="White" CornerRadius="16"
            Margin="10" Padding="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="2"
                              Opacity="0.15" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="Забанить пользователя"
                       FontSize="16" FontWeight="Bold"
                       Foreground="#374151"/>

            <TextBlock Text="Причина" Foreground="#374151"
                       Margin="0,16,0,6"/>
            <Border Background="White" CornerRadius="10"
                    BorderBrush="#E5E7EB" BorderThickness="1"
                    Height="44">
                <ComboBox x:Name="ReasonCombo"
                          Style="{StaticResource FlatCombo}"
                          SelectedIndex="0"
                          SelectionChanged="ReasonChanged"/>
            </Border>

            <StackPanel x:Name="CustomReasonBlock" Visibility="Collapsed">
                <TextBlock Text="Своя причина" Foreground="#374151"
                           Margin="0,16,0,6"/>
                <Border Background="White" CornerRadius="10"
                        BorderBrush="#E5E7EB" BorderThickness="1"
                        MinHeight="80">
                    <TextBox x:Name="CustomReasonBox"
                             Background="Transparent" BorderThickness="0"
                             Padding="14,10" TextWrapping="Wrap"
                             AcceptsReturn="True" MaxLength="500"
                             VerticalContentAlignment="Top"/>
                </Border>
            </StackPanel>

            <TextBlock Text="Срок бана" Foreground="#374151"
                       Margin="0,16,0,6"/>
            <Border Background="White" CornerRadius="10"
                    BorderBrush="#E5E7EB" BorderThickness="1"
                    Height="44">
                <ComboBox x:Name="DurationCombo"
                          Style="{StaticResource FlatCombo}"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Навсегда"/>
                    <ComboBoxItem Content="1 день"/>
                    <ComboBoxItem Content="7 дней"/>
                    <ComboBoxItem Content="30 дней"/>
                    <ComboBoxItem Content="1 год"/>
                </ComboBox>
            </Border>

            <TextBlock x:Name="ErrorText"
                       Foreground="#DC2626" FontSize="12"
                       Margin="0,12,0,0"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Отмена" Width="130" Height="42"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryBtn}"
                        Click="Cancel_Click"/>
                <Button Content="Забанить" Width="150" Height="42"
                        Style="{StaticResource PrimaryBtn}"
                        Click="Ban_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>