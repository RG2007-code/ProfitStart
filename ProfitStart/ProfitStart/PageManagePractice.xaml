<Page x:Class="ProfitStart.PageManagePractice"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Практики"
                       FontSize="26" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}"/>
            <Button Content="+ Добавить практику"
                    Width="200" Height="44"
                    HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryBtn}"
                    Click="Add_Click"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PracticeList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBg}"
                                CornerRadius="10"
                                Padding="20" Margin="0,0,0,12"
                                Cursor="Hand"
                                Tag="{Binding Id}"
                                MouseLeftButtonUp="Card_Click">
                            <Grid>
                                <StackPanel Orientation="Horizontal">

                                    <Grid Width="48" Height="48"
                                          VerticalAlignment="Center">
                                        <Ellipse Width="48" Height="48"
                                                 Fill="{DynamicResource AccentBgSoft}"/>
                                        <Ellipse Width="48" Height="48"
                                                 Tag="{Binding AvatarData}"
                                                 Loaded="PracticeAvatar_Loaded"/>
                                    </Grid>

                                    <StackPanel Margin="16,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="Bold" FontSize="15"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontSize="12"
                                                   Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding StatusColor}"
                                                   FontSize="12"
                                                   Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Reason}"
                                                   Foreground="#DC2626"
                                                   FontSize="12"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Button Content="Ред."
                                            Width="90" Height="38"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryBtn}"
                                            Tag="{Binding Id}"
                                            Click="Edit_Click"/>
                                    <Button Content="Удалить"
                                            Width="100" Height="38"
                                            Style="{StaticResource GhostBtn}"
                                            Foreground="#DC2626"
                                            Tag="{Binding Id}"
                                            Click="Delete_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>