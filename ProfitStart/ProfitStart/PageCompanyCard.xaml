<Page x:Class="ProfitStart.PageCompanyCard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Button Content="← Назад"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,20"
                        Style="{StaticResource GhostBtn}"
                        Click="Back_Click"/>

                <Border x:Name="DeletedBanner"
                        Background="#FEE2E2" CornerRadius="10"
                        Padding="16" Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="⚠ Компания удалена"
                                   FontWeight="Bold"
                                   Foreground="#DC2626"/>
                        <TextBlock x:Name="DeletedReason"
                                   Foreground="#DC2626"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBg}"
                        CornerRadius="10"
                        Padding="24" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="64" Height="64" VerticalAlignment="Center">
                            <Ellipse Width="64" Height="64"
                                     Fill="{DynamicResource AccentBgSoft}"/>
                            <Ellipse x:Name="AvatarBig"
                                     Width="64" Height="64"/>
                        </Grid>
                        <StackPanel Margin="20,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="NameText"
                                       FontWeight="Bold" FontSize="22"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="DirText"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="14"
                                       Margin="0,6,0,0"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,6,0,0">
                                <TextBlock x:Name="StarsText"
                                           Foreground="#F59E0B"
                                           FontSize="16"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="RatingText"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="13"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel x:Name="RateBlock"
                                        Margin="0,12,0,0"
                                        Visibility="Collapsed">
                                <TextBlock x:Name="RateHint"
                                           Text="Поставьте оценку:"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="12"
                                           Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="Star1" Content="☆"
                                            Tag="1" Click="Star_Click"
                                            Style="{StaticResource StarBtn}"/>
                                    <Button x:Name="Star2" Content="☆"
                                            Tag="2" Click="Star_Click"
                                            Style="{StaticResource StarBtn}"/>
                                    <Button x:Name="Star3" Content="☆"
                                            Tag="3" Click="Star_Click"
                                            Style="{StaticResource StarBtn}"/>
                                    <Button x:Name="Star4" Content="☆"
                                            Tag="4" Click="Star_Click"
                                            Style="{StaticResource StarBtn}"/>
                                    <Button x:Name="Star5" Content="☆"
                                            Tag="5" Click="Star_Click"
                                            Style="{StaticResource StarBtn}"/>
                                </StackPanel>
                                <TextBlock x:Name="MyRatingText"
                                           Foreground="#5B5BF5"
                                           FontSize="12"
                                           Margin="0,6,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="ОГРН"
                           FontWeight="Bold" Margin="0,8,0,6"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="OgrnText"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Text="О компании"
                           FontWeight="Bold" Margin="0,20,0,6"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="DescText"
                           Foreground="{DynamicResource TextPrimary}"
                           TextWrapping="Wrap"/>

               
                <StackPanel Orientation="Horizontal" Margin="0,32,0,16">
                    <TextBlock Text="Показать:" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="0,0,10,0"/>
                    <Border Background="{DynamicResource CardBg}"
                            CornerRadius="22" Height="40" Width="220"
                            Margin="0,0,16,0">
                        <ComboBox x:Name="ContentFilter"
                                  Style="{StaticResource FlatCombo}"
                                  SelectedIndex="0"
                                  SelectionChanged="ContentFilter_Changed">
                            <ComboBoxItem Content="Всё"/>
                            <ComboBoxItem Content="Только отзывы"/>
                            <ComboBoxItem Content="Только вакансии"/>
                        </ComboBox>
                    </Border>

                    <TextBlock Text="Оценка:" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="0,0,10,0"/>
                    <Border Background="{DynamicResource CardBg}"
                            CornerRadius="22" Height="40" Width="180">
                        <ComboBox x:Name="StarsFilter"
                                  Style="{StaticResource FlatCombo}"
                                  SelectedIndex="0"
                                  SelectionChanged="StarsFilter_Changed">
                            <ComboBoxItem Content="Все оценки"/>
                            <ComboBoxItem Content="5 звёзд"/>
                            <ComboBoxItem Content="4 звезды"/>
                            <ComboBoxItem Content="3 звезды"/>
                            <ComboBoxItem Content="2 звезды"/>
                            <ComboBoxItem Content="1 звезда"/>
                        </ComboBox>
                    </Border>
                </StackPanel>

                
                <StackPanel x:Name="ReviewsBlock">
                    <TextBlock Text="Отзывы студентов"
                               FontSize="18" FontWeight="Bold"
                               Margin="0,0,0,12"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <ItemsControl x:Name="ReviewsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBg}"
                                        CornerRadius="10"
                                        Padding="18" Margin="0,0,0,10">
                                    <StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="36" Height="36"
                                                  VerticalAlignment="Center">
                                                <Ellipse Width="36" Height="36"
                                                         Fill="{DynamicResource AccentBgSoft}"/>
                                                <Ellipse Width="36" Height="36"
                                                         Tag="{Binding UserAvatar}"
                                                         Loaded="ReviewAvatar_Loaded"/>
                                            </Grid>
                                            <StackPanel Margin="12,0,0,0"
                                                        VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding UserName}"
                                                               FontWeight="Bold"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource TextPrimary}"/>
                                                    <TextBlock Text="{Binding Stars}"
                                                               Foreground="#F59E0B"
                                                               FontSize="13"
                                                               Margin="12,0,0,0"/>
                                                    <TextBlock Text="{Binding DateText}"
                                                               Foreground="{DynamicResource TextPlaceholder}"
                                                               FontSize="11"
                                                               Margin="12,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Comment}"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Margin="0,10,0,0"/>

                                        <Border Background="{DynamicResource AccentBgSoft}"
                                                CornerRadius="8"
                                                Padding="12"
                                                Margin="0,10,0,0"
                                                Visibility="{Binding ReplyVisibility}">
                                            <StackPanel>
                                                <TextBlock Text="Ответ компании:"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           Foreground="#5B5BF5"/>
                                                <TextBlock Text="{Binding CompanyReply}"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,10,0,0">

                                            
                                            <Button Content="Ответить"
                                                    Width="110" Height="32"
                                                    Margin="0,0,8,0"
                                                    Style="{StaticResource GhostBtn}"
                                                    Tag="{Binding Id}"
                                                    Visibility="{Binding ReplyButtonVisibility}"
                                                    Click="Reply_Click"/>

                                            
                                            <Button Content="Редактировать ответ"
                                                    Width="180" Height="32"
                                                    Margin="0,0,8,0"
                                                    Style="{StaticResource GhostBtn}"
                                                    Tag="{Binding Id}"
                                                    Visibility="{Binding EditReplyButtonVisibility}"
                                                    Click="EditReply_Click"/>

                                            
                                            <Button Content="Удалить ответ"
                                                    Width="140" Height="32"
                                                    Margin="0,0,8,0"
                                                    Style="{StaticResource GhostBtn}"
                                                    Foreground="#DC2626"
                                                    Tag="{Binding Id}"
                                                    Visibility="{Binding EditReplyButtonVisibility}"
                                                    Click="DeleteReply_Click"/>

                                            
                                            <Button Content="Удалить (автор)"
                                                    Width="140" Height="32"
                                                    Margin="0,0,8,0"
                                                    Style="{StaticResource GhostBtn}"
                                                    Foreground="#DC2626"
                                                    Tag="{Binding Id}"
                                                    Visibility="{Binding DeleteVisibility}"
                                                    Click="DeleteReview_Click"/>

                                            
                                            <Button Content="Удалить (админ)"
                                                    Width="150" Height="32"
                                                    Style="{StaticResource GhostBtn}"
                                                    Foreground="#DC2626"
                                                    Tag="{Binding Id}"
                                                    Visibility="{Binding AdminDeleteVisibility}"
                                                    Click="AdminDelete_Click"/>
                                        </StackPanel>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="NoReviewsText"
                               Text="Пока нет отзывов"
                               Foreground="{DynamicResource TextPlaceholder}"
                               FontSize="13"
                               Margin="0,4,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>

                
                <StackPanel x:Name="VacanciesBlock">
                    <TextBlock Text="Вакансии компании"
                               FontSize="18" FontWeight="Bold"
                               Margin="0,32,0,12"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <ItemsControl x:Name="RequestsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBg}"
                                        CornerRadius="10"
                                        Padding="20" Margin="0,0,0,10"
                                        Cursor="Hand"
                                        Tag="{Binding Id}"
                                        MouseLeftButtonUp="Request_Click">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="48" Height="48"
                                                  VerticalAlignment="Center">
                                                <Ellipse Width="48" Height="48"
                                                         Fill="{DynamicResource AccentBgSoft}"/>
                                                <Ellipse Width="48" Height="48"
                                                         Tag="{Binding AvatarData}"
                                                         Loaded="VacancyAvatar_Loaded"/>
                                            </Grid>
                                            <StackPanel Margin="16,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="Bold" FontSize="14"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           FontSize="12"
                                                           Margin="0,4,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Type}"
                                                   Foreground="#5B5BF5"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="EmptyText"
                               Text="Пока нет вакансий"
                               Foreground="{DynamicResource TextPlaceholder}"
                               Margin="0,8,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>