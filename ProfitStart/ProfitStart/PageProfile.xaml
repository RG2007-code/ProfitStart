<Page x:Class="ProfitStart.PageProfile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Мой профиль"
                           FontSize="26" FontWeight="Bold"
                           Margin="0,0,0,24"
                           Foreground="{DynamicResource TextPrimary}"/>

                <Border Background="{DynamicResource CardBg}"
                        CornerRadius="10" Padding="24">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="80" Height="80">
                            <Ellipse Width="80" Height="80"
                                     Fill="{DynamicResource AccentBgSoft}"/>
                            <Ellipse x:Name="AvatarImg" Width="80" Height="80"/>
                        </Grid>
                        <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="NameText"
                                       FontWeight="Bold" FontSize="18"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="SubtitleText"
                                       Foreground="{DynamicResource TextMuted}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Email"
                           FontWeight="Bold" Margin="0,20,0,6"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="EmailText"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Text="Телефон"
                           FontWeight="Bold" Margin="0,20,0,6"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="PhoneText"
                           Foreground="{DynamicResource TextPrimary}"/>

                <StackPanel x:Name="OgrnBlock">
                    <TextBlock Text="ОГРН"
                               FontWeight="Bold" Margin="0,20,0,6"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="OgrnText"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>

                <StackPanel x:Name="InnBlock">
                    <TextBlock Text="ИНН"
                               FontWeight="Bold" Margin="0,20,0,6"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="InnText"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>

                <StackPanel x:Name="DirBlock">
                    <TextBlock Text="Сфера деятельности"
                               FontWeight="Bold" Margin="0,20,0,6"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="DirText"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>

                <StackPanel x:Name="AboutBlock">
                    <TextBlock Text="О компании"
                               FontWeight="Bold" Margin="0,20,0,6"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="AboutText"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel x:Name="CourseBlock">
                    <TextBlock Text="Курс"
                               FontWeight="Bold" Margin="0,20,0,6"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="CourseText"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>

                <StackPanel x:Name="StudentCardBlock">
                    <TextBlock Text="Номер студенческого"
                               FontWeight="Bold" Margin="0,20,0,6"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="StudentCardText"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>

                <StackPanel x:Name="DirectionBlock">
                    <TextBlock Text="Направление подготовки"
                               FontWeight="Bold" Margin="0,20,0,6"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="DirectionText"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>

                <StackPanel x:Name="SkillsBlock">
                    <TextBlock Text="Навыки"
                               FontWeight="Bold" Margin="0,20,0,12"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <WrapPanel x:Name="SkillsPanel"/>
                </StackPanel>

                <StackPanel x:Name="ResumeBlock">
                    <TextBlock Text="Резюме"
                               FontWeight="Bold" Margin="0,20,0,6"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <Border Background="{DynamicResource CardBg}"
                            CornerRadius="10"
                            Padding="20"
                            BorderBrush="{DynamicResource BorderLine}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="ResumeText"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap"/>

                            <Border Height="1"
                                    Background="{DynamicResource BorderLine}"
                                    Margin="0,16,0,16"/>

                            <TextBlock x:Name="PdfNoText"
                                       Text="PDF-резюме не загружено"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="13"
                                       Margin="0,0,0,12"/>

                            <StackPanel x:Name="PdfInfo"
                                        Visibility="Collapsed"
                                        Margin="0,0,0,12">
                                <TextBlock x:Name="PdfNameText"
                                           FontWeight="Bold" FontSize="14"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="PdfDateText"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="12"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PdfUploadBtn"
                                        Content="Загрузить PDF"
                                        Width="150" Height="38"
                                        Style="{StaticResource PrimaryBtn}"
                                        Click="PdfUpload_Click"/>

                                <Button x:Name="PdfOpenBtn"
                                        Content="Открыть"
                                        Width="110" Height="38"
                                        Margin="10,0,0,0"
                                        Style="{StaticResource GhostBtn}"
                                        Visibility="Collapsed"
                                        Click="PdfOpen_Click"/>

                                <Button x:Name="PdfDeleteBtn"
                                        Content="Удалить"
                                        Width="110" Height="38"
                                        Margin="10,0,0,0"
                                        Style="{StaticResource GhostBtn}"
                                        Visibility="Collapsed"
                                        Click="PdfDelete_Click"/>
                            </StackPanel>

                            <TextBlock Text="Допустимый формат: PDF, до 10 МБ"
                                       Foreground="{DynamicResource TextPlaceholder}"
                                       FontSize="11"
                                       Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="DisputeBlock"
                            Visibility="Collapsed"
                            Margin="0,32,0,0">

                    <Border Background="#FEE2E2" CornerRadius="10"
                            Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="⚠ Компания удалена"
                                       FontWeight="Bold"
                                       Foreground="#DC2626"
                                       FontSize="14"/>
                            <TextBlock x:Name="DisputeReasonText"
                                       Foreground="#DC2626"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Вы можете оспорить решение или удалить компанию окончательно."
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"/>

                    <Button Content="⚠ Оспорить удаление"
                            Height="48" Margin="0,0,0,10"
                            Style="{StaticResource PrimaryBtn}"
                            Click="Dispute_Click"/>

                    <Button x:Name="DisputeAlreadySent"
                            Content="Оспаривание отправлено"
                            Height="40" Margin="0,0,0,10"
                            Style="{StaticResource GhostBtn}"
                            IsEnabled="False"
                            Visibility="Collapsed"/>

                    <Button Content="Удалить окончательно"
                            Height="48"
                            Style="{StaticResource GhostBtn}"
                            Foreground="#DC2626"
                            Click="DeleteForever_Click"/>
                </StackPanel>

                <Button x:Name="EditProfileBtn"
                        Content="Редактировать профиль"
                        Height="48" Margin="0,32,0,0"
                        Style="{StaticResource PrimaryBtn}"
                        Click="Edit_Click"/>

                
                <Button x:Name="ChangePasswordBtn"
                        Content="Сменить пароль"
                        Height="48" Margin="0,12,0,0"
                        Style="{StaticResource SecondaryBtn}"
                        Click="ChangePassword_Click"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>