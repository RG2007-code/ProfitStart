<Page x:Class="ProfitStart.PageApplications"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TitleText"
                       Text="Мои отклики"
                       FontSize="26" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}"/>

            <Border x:Name="StatusFilterBorder"
                    Background="{DynamicResource CardBg}" CornerRadius="22"
                    Height="44" Width="220"
                    HorizontalAlignment="Right"
                    Visibility="Collapsed">
                <ComboBox x:Name="StatusFilter"
                          Style="{StaticResource FlatCombo}"
                          SelectedIndex="0"
                          SelectionChanged="StatusFilter_Changed">
                    <ComboBoxItem Content="Все"/>
                    <ComboBoxItem Content="Ожидают"/>
                    <ComboBoxItem Content="Одобрены"/>
                    <ComboBoxItem Content="Отклонены"/>
                </ComboBox>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource CardBg}"
                CornerRadius="22"
                Height="44" Margin="0,0,0,20">
            <Grid>
                <TextBox x:Name="SearchBox"
                         Background="Transparent" BorderThickness="0"
                         Padding="16,0,16,0"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource TextPrimary}"
                         CaretBrush="{DynamicResource TextPrimary}"
                         TextChanged="Search_TextChanged"/>
                <TextBlock x:Name="SearchPlaceholder"
                           Text="Поиск по откликам..."
                           Foreground="{DynamicResource TextPlaceholder}"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AppsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBg}"
                                CornerRadius="10"
                                Padding="20" Margin="0,0,0,14">
                            <StackPanel>

                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="56" Height="56"
                                              VerticalAlignment="Center">
                                            <Ellipse Width="56" Height="56"
                                                     Fill="{DynamicResource AccentBgSoft}"/>
                                            <Ellipse Width="56" Height="56"
                                                     Tag="{Binding AvatarData}"
                                                     Loaded="Avatar_Loaded"/>
                                        </Grid>
                                        <StackPanel Margin="16,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="Bold" FontSize="16"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       FontSize="13"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Background="{Binding StatusBg}"
                                            CornerRadius="12"
                                            Padding="12,6"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding StatusColor}"
                                                   FontWeight="Bold"
                                                   FontSize="12"/>
                                    </Border>
                                </Grid>

                                <Border Background="{DynamicResource AccentBgSoft}"
                                        CornerRadius="8"
                                        Padding="16,12" Margin="0,16,0,0">
                                    <TextBlock Text="{Binding Message}"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="13"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="{Binding RejectionReason}"
                                           Foreground="#DC2626"
                                           FontSize="12"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding ReasonVisibility}"/>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,16,0,0"
                                            Visibility="{Binding CompanyButtonsVisibility}">
                                    <Button Content="Профиль студента"
                                            Width="180" Height="42"
                                            Margin="0,0,10,0"
                                            Style="{StaticResource SecondaryBtn}"
                                            Tag="{Binding StudentId}"
                                            Click="StudentProfile_Click"/>
                                    <Button Content="Написать"
                                            Width="130" Height="42"
                                            Margin="0,0,10,0"
                                            Style="{StaticResource GhostBtn}"
                                            Tag="{Binding StudentId}"
                                            Click="WriteMessage_Click"/>
                                    <Button Content="Одобрить"
                                            Width="140" Height="42"
                                            Margin="0,0,10,0"
                                            Style="{StaticResource PrimaryBtn}"
                                            Tag="{Binding Id}"
                                            Visibility="{Binding ApproveButtonsVisibility}"
                                            Click="Approve_Click"/>
                                    <Button Content="Отказать"
                                            Width="140" Height="42"
                                            Style="{StaticResource GhostBtn}"
                                            Foreground="#DC2626"
                                            Tag="{Binding Id}"
                                            Visibility="{Binding ApproveButtonsVisibility}"
                                            Click="Reject_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="EmptyText"
                   Grid.Row="2"
                   Text="Пока нет откликов"
                   Foreground="{DynamicResource TextPlaceholder}"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</Page>