<Page x:Class="ProfitStart.PageManageUsers"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Управление пользователями"
                   FontSize="26" FontWeight="Bold"
                   Margin="0,0,0,16"
                   Foreground="{DynamicResource TextPrimary}"/>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Border Background="{DynamicResource CardBg}"
                    CornerRadius="22"
                    Height="44" HorizontalAlignment="Left" Width="600">
                <Grid>
                    <TextBox x:Name="SearchBox"
                             Background="Transparent" BorderThickness="0"
                             Padding="16,0,16,0"
                             VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource TextPrimary}"
                             TextChanged="Search_TextChanged"/>
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Поиск по email или телефону..."
                               Foreground="{DynamicResource TextPlaceholder}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Button Content="Забаненные"
                    Width="180" Height="44"
                    HorizontalAlignment="Right"
                    Style="{StaticResource GhostBtn}"
                    Click="ShowBans_Click"/>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="UsersList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBg}"
                                CornerRadius="10"
                                Padding="20" Margin="0,0,0,12">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="48" Height="48"
                                          VerticalAlignment="Center">
                                        <Ellipse Width="48" Height="48"
                                                 Fill="{DynamicResource AccentBgSoft}"/>
                                        <Ellipse Width="48" Height="48"
                                                 Tag="{Binding AvatarData}"
                                                 Loaded="UserAvatar_Loaded"/>
                                    </Grid>

                                    <StackPanel Margin="16,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Email}"
                                                   FontWeight="Bold" FontSize="15"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding Info}"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontSize="12"
                                                   Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Role}"
                                                   Foreground="#5B5BF5" FontSize="12"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Button Content="Написать"
                                            Width="100" Height="38"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource GhostBtn}"
                                            Tag="{Binding Id}"
                                            Visibility="{Binding CanMessage}"
                                            Click="Message_Click"/>
                                    <Button Content="{Binding BanButtonText}"
                                            Width="110" Height="38"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource PrimaryBtn}"
                                            Tag="{Binding Id}"
                                            Visibility="{Binding CanBan}"
                                            Click="BanOrUnban_Click"/>
                                    <Button Content="Удалить"
                                            Width="100" Height="38"
                                            Style="{StaticResource GhostBtn}"
                                            Foreground="#DC2626"
                                            Tag="{Binding Id}"
                                            Visibility="{Binding CanDelete}"
                                            Click="Delete_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>