<Page x:Class="ProfitStart.PageBannedUsers"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="← Назад"
                HorizontalAlignment="Left"
                Style="{StaticResource GhostBtn}"
                Click="Back_Click"/>

        <TextBlock Grid.Row="1" Text="Забаненные пользователи"
                   FontSize="26" FontWeight="Bold"
                   Margin="0,16,0,24"
                   Foreground="{DynamicResource TextPrimary}"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="BansList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding RowBackground}"
                                    CornerRadius="10"
                                    Padding="20" Margin="0,0,0,12">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">

                                       
                                        <Grid Width="40" Height="40"
                                              VerticalAlignment="Center"
                                              Margin="0,0,14,0">
                                            <Ellipse Width="40" Height="40"
                                                     Fill="{DynamicResource AccentBgSoft}"/>
                                            <Ellipse Width="40" Height="40"
                                                     Tag="{Binding AvatarData}"
                                                     Loaded="BanAvatar_Loaded"/>
                                        </Grid>

                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Email}"
                                                           FontWeight="Bold" FontSize="15"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <Border Background="{Binding StatusBg}"
                                                        CornerRadius="10"
                                                        Padding="8,2"
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Foreground="White"
                                                               FontSize="11"
                                                               FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Info}"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       FontSize="12"
                                                       Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Reason}"
                                                       Foreground="#DC2626" FontSize="12"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Content="Разбанить"
                                            Width="130" Height="38"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource PrimaryBtn}"
                                            Tag="{Binding Id}"
                                            Click="Unban_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyText"
                           Text="Нет забаненных"
                           Foreground="{DynamicResource TextPlaceholder}"
                           HorizontalAlignment="Center"
                           Margin="0,40,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>