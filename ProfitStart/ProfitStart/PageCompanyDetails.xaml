<Page x:Class="ProfitStart.PageCompanyDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Button Content="← Назад"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,20"
                        Style="{StaticResource GhostBtn}"
                        Click="Back_Click"/>

                <Border Background="{DynamicResource CardBg}"
                        CornerRadius="10"
                        Padding="24" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">

                        <Grid Width="48" Height="48"
                              VerticalAlignment="Center">
                            <Ellipse Width="48" Height="48"
                                     Fill="{DynamicResource AccentBgSoft}"/>
                            <Ellipse x:Name="AvatarBig"
                                     Width="48" Height="48"/>
                        </Grid>

                        <StackPanel Margin="20,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="NameText"
                                       FontWeight="Bold" FontSize="20"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="DirText"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="14"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="ОГРН"
                           FontWeight="Bold" Margin="0,8,0,6"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="OgrnText"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Text="О компании"
                           FontWeight="Bold" Margin="0,20,0,6"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="DescText"
                           Foreground="{DynamicResource TextPrimary}"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="StatusText"
                           Foreground="#D97706"
                           Margin="0,20,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>