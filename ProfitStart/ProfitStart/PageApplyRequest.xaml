<Page x:Class="ProfitStart.PageApplyRequest"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Button Content="← Назад"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,20"
                        Style="{StaticResource GhostBtn}"
                        Click="Back_Click"/>

                <TextBlock Text="Отклик"
                           FontSize="26" FontWeight="Bold"
                           Margin="0,0,0,8"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock x:Name="RequestTitleText"
                           FontSize="16" FontWeight="Bold"
                           Foreground="#5B5BF5"
                           Margin="0,0,0,24"/>

                <Border Background="{DynamicResource AccentBgSoft}"
                        CornerRadius="10"
                        Padding="16" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="ℹ Ваши документы будут доступны компании"
                                   FontWeight="Bold"
                                   Foreground="#5B5BF5"
                                   FontSize="13"/>
                        <TextBlock Text="Резюме и паспорт берутся из вашего профиля."
                                   Foreground="#5B5BF5" FontSize="12"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Текст отклика (до 500 символов)"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,0,6"/>
                <Border Background="{DynamicResource CardBg}"
                        CornerRadius="10" MinHeight="150">
                    <TextBox x:Name="MessageBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="14,10"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MaxLength="500"
                             VerticalContentAlignment="Top"
                             Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource TextPrimary}"
                             TextChanged="Message_TextChanged"/>
                </Border>
                <TextBlock x:Name="CounterText"
                           Foreground="{DynamicResource TextPlaceholder}"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           Margin="0,4,0,0" Text="0 / 500"/>

                <TextBlock x:Name="ErrorText" Foreground="#DC2626"
                           FontSize="12" Margin="0,16,0,0"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="Отмена" Width="130" Height="44"
                            Margin="0,0,10,0"
                            Style="{StaticResource SecondaryBtn}"
                            Click="Back_Click"/>
                    <Button Content="Отправить"
                            Width="180" Height="44"
                            Style="{StaticResource PrimaryBtn}"
                            Click="Send_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>