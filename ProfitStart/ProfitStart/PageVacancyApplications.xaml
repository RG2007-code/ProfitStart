<Page x:Class="ProfitStart.PageVacancyApplications"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Button Content="← Назад"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,20"
                        Style="{StaticResource GhostBtn}"
                        Click="Back_Click"/>

                <TextBlock x:Name="VacancyTitle"
                           FontSize="22" FontWeight="Bold"
                           Margin="0,0,0,20"
                           Foreground="{DynamicResource TextPrimary}"/>

                <ItemsControl x:Name="ApplicationsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBg}"
                                    CornerRadius="10"
                                    Padding="20" Margin="0,0,0,12">
                                <StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="48" Height="48"
                                              VerticalAlignment="Center">
                                            <Ellipse Width="48" Height="48"
                                                     Fill="{DynamicResource AccentBgSoft}"/>
                                            <Ellipse Width="48" Height="48"
                                                     Tag="{Binding StudentAvatar}"
                                                     Loaded="StudentAvatar_Loaded"/>
                                        </Grid>
                                        <StackPanel Margin="16,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StudentName}"
                                                       FontWeight="Bold" FontSize="15"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       FontSize="12"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Message}"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="13"
                                               Margin="0,12,0,0"
                                               TextWrapping="Wrap"/>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,12,0,0">
                                        <Button Content="Профиль студента"
                                                Width="160" Height="36"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource SecondaryBtn}"
                                                Tag="{Binding StudentId}"
                                                Click="StudentProfile_Click"/>
                                        <Button Content="Интервью"
                                                Width="110" Height="36"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource PrimaryBtn}"
                                                Tag="{Binding Id}"
                                                Click="Interview_Click"/>
                                        <Button Content="Оффер"
                                                Width="100" Height="36"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource PrimaryBtn}"
                                                Tag="{Binding Id}"
                                                Click="Offer_Click"/>
                                        <Button Content="Отказ"
                                                Width="100" Height="36"
                                                Style="{StaticResource GhostBtn}"
                                                Foreground="#DC2626"
                                                Tag="{Binding Id}"
                                                Click="Reject_Click"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Status}"
                                               Foreground="#5B5BF5"
                                               FontWeight="Bold"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>