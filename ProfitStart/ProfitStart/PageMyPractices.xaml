<Page x:Class="ProfitStart.PageMyPractices"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBg}">
    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Мои практики"
                   FontSize="26" FontWeight="Bold"
                   Margin="0,0,0,16"
                   Foreground="{DynamicResource TextPrimary}"/>

        <Border Grid.Row="1"
                Background="{DynamicResource CardBg}"
                CornerRadius="22"
                Height="44" Margin="0,0,0,20">
            <Grid>
                <TextBox x:Name="SearchBox"
                         Background="Transparent" BorderThickness="0"
                         Padding="16,0,16,0"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource TextPrimary}"
                         CaretBrush="{DynamicResource TextPrimary}"
                         TextChanged="Search_TextChanged"/>
                <TextBlock x:Name="SearchPlaceholder"
                           Text="Поиск по моим практикам..."
                           Foreground="{DynamicResource TextPlaceholder}"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="PracticesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBg}"
                                    CornerRadius="10"
                                    Padding="20" Margin="0,0,0,12"
                                    Cursor="Hand"
                                    Tag="{Binding Id}"
                                    MouseLeftButtonUp="Card_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="48" Height="48"
                                              VerticalAlignment="Center">
                                            <Ellipse Width="48" Height="48"
                                                     Fill="{DynamicResource AccentBgSoft}"/>
                                            <Ellipse Width="48" Height="48"
                                                     Tag="{Binding AvatarData}"
                                                     Loaded="PracticeAvatar_Loaded"/>
                                        </Grid>
                                        <StackPanel Margin="16,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="Bold" FontSize="15"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       FontSize="12"
                                                       Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding CompanyName}"
                                                       Foreground="#5B5BF5"
                                                       FontSize="12"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Border Background="#DCFCE7" CornerRadius="12"
                                                Padding="10,4"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="✓ Одобрен"
                                                       Foreground="#16A34A"
                                                       FontSize="12"
                                                       FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyText"
                           Text="Пока нет одобренных практик"
                           Foreground="{DynamicResource TextPlaceholder}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,40,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>