<Window x:Class="ProfitStart.AdminMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Написать пользователю"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="White" CornerRadius="16"
            Margin="10" Padding="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="2"
                              Opacity="0.15" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="TitleText"
                       Text="Написать пользователю"
                       FontSize="16" FontWeight="Bold"
                       Foreground="#374151"/>

            <Border Background="White" CornerRadius="10"
                    BorderBrush="#E5E7EB" BorderThickness="1"
                    MinHeight="120" Margin="0,16,0,0">
                <TextBox x:Name="MsgBox"
                         Background="Transparent" BorderThickness="0"
                         Padding="14,10" TextWrapping="Wrap"
                         AcceptsReturn="True" MaxLength="500"
                         VerticalContentAlignment="Top"/>
            </Border>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Отмена" Width="120" Height="42"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryBtn}"
                        Click="Cancel_Click"/>
                <Button Content="Отправить" Width="140" Height="42"
                        Style="{StaticResource PrimaryBtn}"
                        Click="Send_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>